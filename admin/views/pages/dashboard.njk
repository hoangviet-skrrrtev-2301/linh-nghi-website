{% extends "layout.njk" %}
{% from "partials/icons.njk" import icon %}
{% block title %}Tổng quan{% endblock %}
{% block heading %}Tổng quan{% endblock %}
{% block content %}
<div x-data="dashboard">
  {% set helpKey = 'dashboard' %}{% include "partials/page-help.njk" %}
  <div x-cloak x-show="d && !d.mailConfigured" class="mb-6 flex flex-wrap items-center gap-3 rounded-xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-800">
    {{ icon('alert', 'w-5 h-5') }}
    <span class="flex-1">Email thông báo đơn hàng chưa được bật. Đơn hàng vẫn được lưu trong hệ thống nhưng bạn sẽ không nhận email.</span>
    {% if can('mail') %}<a href="{{ A }}/settings/mail" class="btn btn-secondary btn-sm">Cấu hình email</a>{% endif %}
  </div>

  {# ---- Việc cần làm trước khi mở web chính thức (tự mất khi đã xong) ---- #}
  <div x-cloak x-show="d && d.launch && d.launch.length" class="mb-6 rounded-xl border border-brand-200 bg-brand-50/60 px-5 py-4 text-sm" x-data="{ open: false }">
    <button type="button" class="flex w-full items-center justify-between gap-3 text-left font-medium text-slate-800" @click="open = !open" :aria-expanded="open">
      <span>Việc cần chú ý: chuẩn bị mở web và sao lưu <span class="ml-1 font-normal text-slate-500" x-text="'(' + (d?.launch?.length || 0) + ' việc)'"></span></span>
      <span class="text-xs text-brand-600" x-text="open ? 'Thu gọn' : 'Xem'"></span>
    </button>
    <ul class="mt-3 space-y-2" x-show="open" x-collapse>
      <template x-for="it in (d?.launch || [])" :key="it.text">
        <li class="flex flex-wrap items-start gap-2">
          <span class="mt-0.5 inline-block h-2 w-2 shrink-0 rounded-full" :class="it.level === 'warn' ? 'bg-amber-500' : 'bg-sky-500'"></span>
          <span class="flex-1" x-text="it.text"></span>
          <a x-show="it.group !== 'backup'" :href="'{{ A }}/settings/' + it.group" class="inline-block py-1 text-brand-600 hover:underline">Mở cài đặt</a>
        </li>
      </template>
    </ul>
  </div>

  {# ---- Chọn khoảng thời gian xem ---- #}
  <div class="mb-5 flex flex-wrap items-center gap-2">
    <template x-for="r in ranges" :key="r[0]">
      <button type="button" class="rounded-full border px-3.5 py-1.5 text-sm transition" :class="range === r[0] ? 'border-brand-600 bg-brand-600 text-white' : 'border-slate-300 text-slate-600 hover:border-brand-500'" @click="setRange(r[0])" x-text="r[1]"></button>
    </template>
    <div class="flex flex-wrap items-center gap-2" x-show="range === 'custom'" x-cloak>
      <input type="date" class="input !w-auto !py-1.5" x-model="from" @change="save(); from && to && load()" aria-label="Từ ngày">
      <span class="text-slate-400">→</span>
      <input type="date" class="input !w-auto !py-1.5" x-model="to" @change="save(); from && to && load()" aria-label="Đến ngày">
    </div>
    <p class="ml-auto text-xs text-slate-500" x-show="d" x-cloak><span x-text="d?.range.text"></span> · <span x-text="d?.range.days"></span> ngày</p>
  </div>

  {# ---- So sánh kỳ (mặc định tắt) ---- #}
  <div class="mb-5 flex flex-wrap items-center gap-2">
    <button type="button" class="inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm transition" :class="compare ? 'border-brand-600 bg-brand-50 text-brand-700' : 'border-slate-300 text-slate-600 hover:border-brand-500'" :aria-pressed="compare ? 'true' : 'false'" @click="setCompare(compare ? '' : 'prev')">
      {{ icon('clock', 'w-4 h-4') }} So sánh<span x-show="compare" x-cloak>: đang bật</span>
    </button>
    <template x-if="compare">
      <div class="flex flex-wrap items-center gap-2">
        <template x-for="m in compareModes" :key="m[0]">
          <button type="button" class="rounded-full border px-3 py-1 text-xs transition" :class="compare === m[0] ? 'border-brand-600 bg-brand-600 text-white' : 'border-slate-300 text-slate-600 hover:border-brand-500'" @click="setCompare(m[0])" x-text="m[1]"></button>
        </template>
        <span class="flex flex-wrap items-center gap-2" x-show="compare === 'custom'">
          <input type="date" class="input !w-auto !py-1.5" x-model="cfrom" @change="cfrom && cto && load()" aria-label="Kỳ so sánh từ ngày">
          <span class="text-slate-400">→</span>
          <input type="date" class="input !w-auto !py-1.5" x-model="cto" @change="cfrom && cto && load()" aria-label="Kỳ so sánh đến ngày">
        </span>
      </div>
    </template>
    <p class="text-xs text-slate-500" x-show="d && d.compare" x-cloak>So với <b x-text="d?.compare?.text"></b> (<span x-text="d?.compare?.days"></span> ngày)<span class="text-amber-600" x-show="d?.compare && d.compare.days !== d.range.days"> · hai kỳ dài khác nhau, số liệu không cùng thang đo</span></p>
  </div>

  {# ---- Thẻ số liệu theo kỳ ---- #}
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-6" :class="loading && 'opacity-60'">
    {% for k in [
      ['orders', 'Đơn hàng mới', 'bag', 'text-blue-600 bg-blue-50', '/inquiries?type=order'],
      ['custom', 'Yêu cầu custom', 'sparkle', 'text-violet-600 bg-violet-50', '/inquiries?type=custom'],
      ['contact', 'Lời nhắn liên hệ', 'mail', 'text-amber-600 bg-amber-50', '/inquiries?type=contact'],
      ['customers', 'Khách mới', 'users', 'text-sky-600 bg-sky-50', '/customers'],
      ['revenue', 'Doanh thu', 'gem', 'text-emerald-600 bg-emerald-50', '/inquiries?type=order&status=completed'],
      ['aov', 'Giá trị TB / đơn', 'tag', 'text-rose-600 bg-rose-50', '/inquiries?type=order&status=completed']
    ] %}
    <a href="{{ A }}{{ k[4] }}" class="card flex flex-col gap-3 p-4 transition hover:border-brand-500">
      <div class="flex items-center gap-2"><span class="flex h-9 w-9 items-center justify-center rounded-lg {{ k[3] }}">{{ icon(k[2], 'w-[18px] h-[18px]') }}</span>
        <p class="text-xs leading-tight text-slate-500">{{ k[1] }}</p></div>
      <p class="{{ 'text-xl' if k[0] in ['revenue', 'aov'] else 'text-2xl' }} font-semibold leading-none" x-text="show('{{ k[0] }}')">–</p>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px]">
        <span class="badge" :class="deltaClass('{{ k[0] }}')" x-show="delta('{{ k[0] }}')" x-text="deltaIcon('{{ k[0] }}') + ' ' + delta('{{ k[0] }}')?.text"></span>
        {% if k[0] == 'orders' %}<span class="text-slate-500" x-show="d && (d.pending.order || d.pending.shipping)" x-text="d ? (d.pending.order ? d.pending.order + ' chờ xử lý' : '') + (d.pending.order && d.pending.shipping ? ' · ' : '') + (d.pending.shipping ? d.pending.shipping + ' đang giao' : '') : ''"></span>
        {% elif k[0] == 'custom' %}<span class="text-slate-500" x-show="d && d.pending.custom" x-text="d ? d.pending.custom + ' chờ xử lý' : ''"></span>
        {% elif k[0] == 'contact' %}<span class="text-slate-500" x-show="d && d.pending.contact" x-text="d ? d.pending.contact + ' chờ xử lý' : ''"></span>
        {% elif k[0] == 'revenue' %}<span class="text-slate-500" x-text="d ? d.totals.completed + ' đơn hoàn thành' : ''"></span>{% endif %}
      </div>
      <p class="-mt-1 text-[11px] text-slate-500" x-show="d && d.prev" x-cloak>Kỳ so sánh: <b class="font-medium text-slate-700" x-text="prevShow('{{ k[0] }}')"></b></p>
    </a>
    {% endfor %}
  </div>
  <p class="mt-2 text-xs text-slate-500">Doanh thu tính theo <b>ngày hoàn thành</b> của đơn hàng. Bấm <b>So sánh</b> ở trên để xem tăng trưởng so với kỳ liền trước, cùng kỳ năm trước hoặc kỳ tự chọn.</p>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:items-start">
    {# ---- Biểu đồ ---- #}
    <div class="card min-w-0 lg:col-span-2">
      <div class="card-head">
        <div>
          <h2 class="card-title" x-text="metric === 'revenue' ? 'Doanh thu theo ' + ({ day: 'ngày', week: 'tuần', month: 'tháng' }[d?.series.unit] || 'ngày') : 'Đơn hàng, custom & khách liên hệ theo ' + ({ day: 'ngày', week: 'tuần', month: 'tháng' }[d?.series.unit] || 'ngày')"></h2>
          <p class="mt-0.5 text-xs text-slate-500">Tổng: <b x-text="chartTotal"></b></p>
        </div>
        <div class="inline-flex rounded-lg border border-slate-300 p-0.5 text-xs">
          <button type="button" class="rounded-md px-2.5 py-1" :class="metric === 'requests' ? 'bg-brand-600 text-white' : 'text-slate-600'" @click="metric = 'requests'; save()">Số yêu cầu</button>
          <button type="button" class="rounded-md px-2.5 py-1" :class="metric === 'revenue' ? 'bg-brand-600 text-white' : 'text-slate-600'" @click="metric = 'revenue'; save()">Doanh thu</button>
        </div>
      </div>
      <div class="card-body">
        {# Ba loại đếm riêng, bấm để ẩn / hiện trên biểu đồ #}
        <div class="mb-5 grid grid-cols-3 gap-2 sm:gap-3" x-show="metric !== 'revenue'">
          <template x-for="s in seriesDefs" :key="s.key">
            <button type="button" class="rounded-xl border border-slate-200 p-3 text-left transition hover:border-slate-300" :class="hidden[s.key] && 'opacity-45'" @click="toggleSeries(s.key)" :aria-pressed="!hidden[s.key]" :title="hidden[s.key] ? 'Bấm để hiện lại trên biểu đồ' : 'Bấm để ẩn khỏi biểu đồ'">
              <span class="flex items-center gap-1.5 text-xs text-slate-500"><i class="h-2.5 w-2.5 shrink-0 rounded-sm" :class="s.dot"></i><span x-text="s.label"></span></span>
              <span class="mt-1 block text-2xl font-semibold leading-none" :class="s.text" x-text="seriesTotal(s.key)"></span>
              <span class="mt-1.5 block text-[11px] leading-tight text-slate-500">
                <template x-if="s.key === 'order'"><span><span x-text="d?.totals.fromRequest || 0"></span> lên từ custom/liên hệ · <span x-text="d?.totals.manual || 0"></span> shop tự thêm</span></template>
                <template x-if="s.key === 'custom'"><span>Yêu cầu thiết kế riêng còn đang xử lý</span></template>
                <template x-if="s.key === 'contact'"><span>Khách nhắn tư vấn, chưa lên đơn</span></template>
              </span>
            </button>
          </template>
        </div>
        <div class="flex gap-2">
          <div class="flex h-48 w-10 shrink-0 flex-col justify-between pt-5 text-right text-[10px] text-slate-400">
            <template x-for="(t, i) in axis" :key="i"><span x-text="t"></span></template>
          </div>
          <div class="min-w-0 flex-1">
            <div class="relative h-48 pt-5">
              <div class="pointer-events-none absolute inset-x-0 top-5 border-t border-dashed border-slate-200"></div>
              <div class="pointer-events-none absolute inset-x-0 top-[calc(50%+10px)] border-t border-dashed border-slate-200"></div>
              <div class="relative flex h-full items-end gap-[3px] border-b border-slate-300">
                <template x-for="(bk, i) in buckets" :key="bk.key">
                  <div class="group flex h-full min-w-0 flex-1 items-end justify-center gap-[2px] rounded-t px-px hover:bg-slate-100/70" :title="bk.title + ': ' + (metric === 'revenue' ? money(bk.revenue) : (bk.order + ' đơn hàng · ' + bk.custom + ' custom · ' + bk.contact + ' khách liên hệ'))">
                    <template x-if="metric === 'revenue'">
                      <div class="relative h-full w-full max-w-[34px]">
                        <div class="absolute inset-x-0 bottom-0 rounded-t bg-emerald-500" :style="'height:' + barH(bk.revenue) + '%'"></div>
                        <span class="pointer-events-none absolute left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] font-semibold leading-none text-slate-700" :style="'bottom: calc(' + barH(bk.revenue) + '% + 3px)'" x-show="showNumbers" x-text="lab(bk.revenue)"></span>
                      </div>
                    </template>
                    <template x-if="metric !== 'revenue'">
                      <div class="contents"><template x-for="s in series" :key="s.key">
                        <div class="relative h-full min-w-0 flex-1" :class="series.length > 1 ? 'max-w-[26px]' : 'max-w-[34px]'">
                          <div class="absolute inset-x-0 bottom-0 rounded-t" :class="s.bar" :style="'height:' + barH(bk[s.key]) + '%'"></div>
                          <span class="pointer-events-none absolute left-1/2 -translate-x-1/2 text-[10px] font-semibold leading-none" :class="s.text" :style="'bottom: calc(' + barH(bk[s.key]) + '% + 3px)'" x-show="showNumbers" x-text="lab(bk[s.key])"></span>
                        </div>
                      </template></div>
                    </template>
                  </div>
                </template>
              </div>
              <p class="absolute inset-x-0 top-1/2 text-center text-sm text-slate-400" x-show="d && !buckets.some(bk => cell(bk))">Chưa có dữ liệu trong kỳ này</p>
            </div>
            <div class="mt-1 flex gap-[3px] text-[10px] text-slate-400">
              <template x-for="(bk, i) in buckets" :key="bk.key"><span class="min-w-0 flex-1 overflow-visible whitespace-nowrap text-center" x-text="showTick(i) ? bk.label : ''"></span></template>
            </div>
          </div>
        </div>
        <p class="mt-3 text-xs text-slate-500" x-show="metric !== 'revenue' && !showNumbers" x-cloak>Nhiều cột nên số được ẩn: rê chuột vào cột để xem số, hoặc mở “Xem số liệu chi tiết” bên dưới.</p>
        <details class="mt-4 text-sm">
          <summary class="cursor-pointer text-brand-600">Xem số liệu chi tiết từng cột</summary>
          <div class="mt-2 max-h-72 overflow-auto rounded-lg border border-slate-200">
            <table class="w-full text-left text-xs">
              <thead class="sticky top-0 bg-slate-50 text-slate-500"><tr><th class="px-3 py-2">Thời gian</th><th class="px-3 py-2">Đơn</th><th class="px-3 py-2">Custom</th><th class="px-3 py-2">Khách liên hệ</th><th class="px-3 py-2 text-right">Doanh thu</th></tr></thead>
              <tbody><template x-for="bk in buckets" :key="bk.key"><tr class="border-t border-slate-100"><td class="px-3 py-1.5" x-text="bk.title"></td><td class="px-3 py-1.5" x-text="bk.order"></td><td class="px-3 py-1.5" x-text="bk.custom"></td><td class="px-3 py-1.5" x-text="bk.contact"></td><td class="px-3 py-1.5 text-right" x-text="bk.revenue ? money(bk.revenue) : '–'"></td></tr></template></tbody>
            </table>
          </div>
        </details>
      </div>
    </div>

    {# ---- Cột phải: tình trạng đơn, bán chạy, nguồn khách ---- #}
    <div class="space-y-6">
      <div class="card">
        <div class="card-head"><h2 class="card-title">Tình trạng đơn hàng</h2><span class="text-xs text-slate-500">đặt trong kỳ</span></div>
        <div class="card-body space-y-2.5 text-sm">
          <template x-for="s in d?.statusBreakdown || []" :key="s.status">
            <div><div class="flex justify-between"><span x-text="({ new: 'Mới', contacted: 'Đã liên hệ', confirmed: 'Đã xác nhận', shipping: 'Đang giao hàng', completed: 'Hoàn thành', cancelled: 'Đã hủy' })[s.status]"></span><b x-text="s.n"></b></div>
              <div class="mt-1 h-1.5 overflow-hidden rounded bg-slate-100"><div class="h-full rounded" :class="statusColor[s.status]" :style="'width:' + (s.n / statusTotal * 100) + '%'"></div></div></div>
          </template>
          <p class="text-slate-500" x-show="d && !d.statusBreakdown.length">Chưa có đơn hàng trong kỳ này.</p>
        </div>
      </div>
      <div class="card">
        <div class="card-head"><h2 class="card-title">Bán chạy trong kỳ</h2></div>
        <div class="card-body space-y-3 text-sm">
          <template x-for="(p, i) in d?.topProducts || []" :key="p.name">
            <div class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600" x-text="i + 1"></span>
              <div class="min-w-0 flex-1"><p class="truncate font-medium" x-text="p.name"></p><p class="text-xs text-slate-500"><span x-text="p.qty"></span> sản phẩm<span x-show="p.amount"> · <span x-text="money(p.amount)"></span></span></p></div></div>
          </template>
          <p class="text-slate-500" x-show="d && !d.topProducts.length">Chưa có sản phẩm nào được đặt trong kỳ này.</p>
        </div>
      </div>
      <div class="card">
        <div class="card-head"><h2 class="card-title">Khách mới theo nguồn</h2></div>
        <div class="card-body space-y-1.5 text-sm">
          <template x-for="s in d?.sources || []" :key="s.name"><div class="flex justify-between"><span x-text="s.name"></span><b x-text="s.n"></b></div></template>
          <p class="text-slate-500" x-show="d && !d.sources.length">Chưa có khách mới trong kỳ này.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="card lg:col-span-1">
      <div class="card-head"><h2 class="card-title">Nội dung</h2></div>
      <div class="card-body grid grid-cols-2 gap-4 text-sm">
        <a href="{{ A }}/products" class="rounded-lg bg-slate-50 p-4 hover:bg-slate-100"><p class="text-2xl font-semibold" x-text="d?.counts.products ?? '–'"></p><p class="text-slate-500">Sản phẩm đang bán</p></a>
        <a href="{{ A }}/products?status=draft" class="rounded-lg bg-slate-50 p-4 hover:bg-slate-100"><p class="text-2xl font-semibold" x-text="d?.counts.drafts ?? '–'"></p><p class="text-slate-500">Bản nháp</p></a>
        <a href="{{ A }}/customers" class="rounded-lg bg-slate-50 p-4 hover:bg-slate-100"><p class="text-2xl font-semibold" x-text="d?.counts.customers ?? '–'"></p><p class="text-slate-500">Khách hàng</p></a>
        <a href="{{ A }}/posts" class="rounded-lg bg-slate-50 p-4 hover:bg-slate-100"><p class="text-2xl font-semibold" x-text="d?.counts.posts ?? '–'"></p><p class="text-slate-500">Bài viết</p></a>
      </div>
    </div>
    <div class="card min-w-0 lg:col-span-2">
      <div class="card-head"><h2 class="card-title">Mới nhận</h2><a href="{{ A }}/inquiries" class="text-sm text-brand-600 hover:underline">Xem tất cả</a></div>
      <div class="overflow-x-auto">
        <table class="table table-stack">
          <thead><tr><th>Mã</th><th>Loại</th><th class="stack-title">Khách</th><th>Điện thoại</th><th>Trạng thái</th><th>Thời gian</th></tr></thead>
          <tbody>
            <template x-for="i in d?.latest || []" :key="i.id">
              <tr class="cursor-pointer" @click="location.href = '{{ A }}/inquiries/' + i.id">
                <td class="font-mono text-xs" x-text="i.code"></td><td x-text="i.type_label"></td><td class="font-medium" x-text="i.name"></td>
                <td x-text="i.phone"></td><td><span class="badge" :class="Admin.STATUS_COLOR[i.status]" x-text="i.status_label"></span></td>
                <td class="text-slate-500" x-text="$fmt.date(i.created_at)"></td>
              </tr>
            </template>
            <tr x-show="d && !d.latest.length"><td colspan="6" class="py-10 text-center text-slate-500">Chưa có đơn hàng hay yêu cầu nào.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
