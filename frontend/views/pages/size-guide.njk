{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}

{% block content %}
{% set g = s.size_guide %}
<section class="border-b border-line bg-surface {{ bg.page_head.pattern }}" style="{{ bg.page_head.style }}">
  <div class="container-x grid items-center gap-10 py-12 md:py-16 lg:grid-cols-2">
    <div>
      <span class="eyebrow">Chọn size</span>
      <h1 class="mt-3 text-4xl font-medium md:text-5xl">{{ g.title }}</h1>
      <p class="mt-4 max-w-lg text-muted">{{ g.intro }}</p>
    </div>
    {% if g.image %}<img src="{{ g.image.md }}" alt="{{ g.title }}" width="{{ g.image.width }}" height="{{ g.image.height }}" decoding="async" class="w-full rounded-lg object-cover">{% endif %}
  </div>
</section>

<section class="section !pt-14">
  <div class="container-x">
    <div class="grid gap-6 md:grid-cols-3">
      {% for st in g.steps %}
      <div class="reveal card relative p-7">
        <span class="font-heading text-6xl leading-none text-primary/15">0{{ loop.index }}</span>
        <h2 class="mt-2 text-xl font-medium">{{ st.title }}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">{{ st.content }}</p>
      </div>
      {% endfor %}
    </div>

    {% if video %}
    <div class="reveal mx-auto mt-14 {{ 'max-w-[340px]' if video.vertical else 'max-w-4xl' }}">
      <h2 class="mb-5 text-center text-2xl font-medium md:text-3xl">{{ g.video_title }}</h2>
      <div class="{{ 'h-[740px]' if video.vertical else 'aspect-video' }} overflow-hidden rounded-lg border border-line bg-ink/5 shadow-lg">
        <iframe src="{{ video.src }}" title="{{ g.video_title }}" class="h-full w-full" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
    {% endif %}

    {# Công cụ tính ni nhanh #}
    <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_1.4fr]" x-data="sizeCalc({{ g.table | attrjson }})">
      <div class="reveal card h-fit p-7">
        <h2 class="text-2xl font-medium">Tính ni nhanh</h2>
        <p class="mt-1 text-sm text-muted">Nhập chu vi bàn tay khi khép ngón (cm)</p>
        <div class="mt-5 flex gap-2">
          <input type="number" step="0.1" min="10" max="30" x-model.number="hand" class="input" placeholder="Ví dụ: 18.5" aria-label="Chu vi bàn tay">
          <span class="flex items-center text-muted">cm</span>
        </div>
        <div class="mt-5 rounded-md bg-primary/5 p-5 text-center" x-show="hand" x-transition>
          <template x-if="result"><div><p class="text-sm text-muted">Ni phù hợp</p><p class="font-heading text-5xl font-semibold text-primary" x-text="result.size"></p><p class="mt-1 text-xs text-muted" x-text="result.note"></p></div></template>
          <template x-if="!result"><p class="text-sm text-muted">Số đo nằm ngoài bảng. Nhắn shop để được tư vấn riêng.</p></template>
        </div>
      </div>

      <div class="reveal card overflow-x-auto">
        <table class="w-full min-w-[480px] text-sm">
          <thead class="bg-primary text-on-primary"><tr>
            <th class="px-5 py-3.5 text-left font-medium">Ni (mm)</th><th class="px-5 py-3.5 text-left font-medium">Chu vi bàn tay (cm)</th>
            <th class="px-5 py-3.5 text-left font-medium">Cổ tay (cm)</th><th class="px-5 py-3.5 text-left font-medium">Ghi chú</th>
          </tr></thead>
          <tbody>
            {% for r in g.table %}
            <tr class="border-t border-line transition" :class="result && result.i === {{ loop.index0 }} && 'bg-accent/10'">
              <td class="px-5 py-3 font-heading text-lg font-semibold text-primary">{{ r.size }}</td>
              <td class="px-5 py-3">{{ r.hand }}</td><td class="px-5 py-3 text-muted">{{ r.wrist }}</td><td class="px-5 py-3 text-muted">{{ r.note }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {% if g.tips %}
    <div class="reveal mx-auto mt-14 max-w-3xl rounded-lg border border-accent/30 bg-accent/5 p-7 md:p-9">
      <h2 class="flex items-center gap-2 text-2xl font-medium">{{ icon('sparkle', 'w-5 h-5 text-accent') }} Lưu ý</h2>
      <div class="prose-jade mt-4">{{ g.tips | headings(2) | imgdims | safe }}</div>
    </div>
    {% endif %}

    <div class="mt-14 flex flex-wrap justify-center gap-3">
      <a href="/san-pham" class="btn btn-primary">Chọn vòng ngay</a>
      {% if s.site.zalo %}<a href="https://zalo.me/{{ s.site.zalo | phoneHref }}" target="_blank" rel="noopener" class="btn btn-outline">{{ icon('chat', 'w-4 h-4') }} Nhờ shop đo giúp</a>{% endif %}
    </div>
  </div>
</section>
{% endblock %}
