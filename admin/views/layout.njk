{% from "partials/icons.njk" import icon %}
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="{{ csrfToken }}">
  <meta name="admin-path" content="{{ A }}">
  <title>{% block title %}Quản trị{% endblock %} · {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/admin-assets/css/admin.css?v={{ assetVersion }}">
  {% block head %}{% endblock %}
  <script type="application/json" id="admin-meta">{{ meta | jsonScript }}</script>
  <script type="application/json" id="admin-user">{{ currentUser | jsonScript }}</script>
  <link rel="stylesheet" href="/vendor/quill/quill.snow.css">
  <script defer src="/vendor/quill/quill.js"></script>
  <script defer src="/admin-assets/js/core.js?v={{ assetVersion }}"></script>
  <script defer src="/admin-assets/js/pages.js?v={{ assetVersion }}"></script>
  {% block scripts %}{% endblock %}
  <script defer src="/vendor/alpine-sort/cdn.min.js"></script>
  <script defer src="/vendor/alpine-collapse/cdn.min.js"></script>
  <script defer src="/vendor/alpine-focus/cdn.min.js"></script>
  <script defer src="/vendor/alpine/cdn.min.js"></script>
</head>
<body x-data="{ sidebar: false }" class="min-h-screen">
  {# ============ Thanh bên ============ #}
  <div x-cloak x-show="sidebar" class="fixed inset-0 z-40 bg-slate-900/50 lg:hidden" @click="sidebar = false"></div>
  <aside :class="sidebar ? 'translate-x-0' : '-translate-x-full'" class="fixed inset-y-0 left-0 z-50 flex w-64 flex-col bg-slate-900 transition-transform lg:translate-x-0">
    <div class="flex h-16 items-center gap-3 border-b border-white/10 px-5">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white">{{ icon('gem', 'w-5 h-5') }}</span>
      <div class="min-w-0"><p class="truncate text-sm font-semibold text-white">{{ shop.name }}</p><p class="text-[11px] text-slate-400">Trang quản trị</p></div>
    </div>
    {% set p = currentPath %}
    {% macro link(href, label, ic, active) %}{% from "partials/icons.njk" import icon %}<a href="{{ href }}" class="nav-link {{ 'active' if active }}">{{ icon(ic, 'w-[18px] h-[18px]') }} {{ label }}</a>{% endmacro %}
    <nav class="flex-1 overflow-y-auto px-3 py-4">
      {{ link(A, 'Tổng quan', 'home', p == '/') }}
      <p class="nav-section">Bán hàng</p>
      {{ link(A + '/inquiries?type=order', 'Đơn hàng', 'bag', p.startsWith('/inquiries') and query.type == 'order') }}
      {{ link(A + '/inquiries?type=custom', 'Yêu cầu custom', 'sparkle', p.startsWith('/inquiries') and query.type == 'custom') }}
      {{ link(A + '/inquiries?type=contact', 'Liên hệ', 'mail', p.startsWith('/inquiries') and query.type == 'contact') }}
      {{ link(A + '/customers', 'Khách hàng', 'users', p.startsWith('/customers')) }}
      <p class="nav-section">Sản phẩm</p>
      {{ link(A + '/products', 'Sản phẩm', 'box', p.startsWith('/products')) }}
      {{ link(A + '/terms', 'Danh mục & bộ lọc', 'tag', p.startsWith('/terms')) }}
      <p class="nav-section">Nội dung</p>
      {{ link(A + '/gallery', 'Gallery', 'image', p.startsWith('/gallery')) }}
      {{ link(A + '/posts', 'Blog', 'doc', p.startsWith('/posts')) }}
      {{ link(A + '/media', 'Thư viện ảnh', 'folder', p.startsWith('/media')) }}
      <p class="nav-section">Hệ thống</p>
      {{ link(A + '/settings/site', 'Cài đặt website', 'settings', p.startsWith('/settings')) }}
      {% if currentUser.role == 'owner' %}
      {{ link(A + '/users', 'Tài khoản quản trị', 'shield', p.startsWith('/users')) }}
      {{ link(A + '/audit', 'Nhật ký hoạt động', 'clock', p.startsWith('/audit')) }}
      {% endif %}
    </nav>
    <div class="border-t border-white/10 p-3">
      <a href="/" target="_blank" class="nav-link">{{ icon('external', 'w-[18px] h-[18px]') }} Xem website</a>
    </div>
  </aside>

  {# ============ Nội dung ============ #}
  <div class="lg:pl-64">
    <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/90 px-4 backdrop-blur md:px-8">
      <button class="btn btn-ghost -ml-2 lg:hidden" @click="sidebar = true" aria-label="Menu">{{ icon('menu') }}</button>
      <h1 class="truncate text-base font-semibold">{% block heading %}{% endblock %}</h1>
      <div class="ml-auto flex items-center gap-2" x-data="{ open: false }">
        <button class="flex items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-slate-100" @click="open = !open" @click.outside="open = false">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">{{ currentUser.name | first | upper }}</span>
          <span class="hidden text-left sm:block"><span class="block text-sm font-medium leading-tight">{{ currentUser.name }}</span><span class="block text-[11px] text-slate-500">{{ meta.roles[currentUser.role] }}</span></span>
          {{ icon('chevron-down', 'w-4 h-4 text-slate-400') }}
        </button>
        <div x-cloak x-show="open" x-transition class="absolute right-4 top-14 w-52 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg md:right-8">
          <a href="{{ A }}/account" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-50">{{ icon('user', 'w-4 h-4') }} Tài khoản & bảo mật</a>
          <form method="post" action="{{ A }}/logout">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50">{{ icon('logout', 'w-4 h-4') }} Đăng xuất</button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl p-4 md:p-8">
      {% block content %}{% endblock %}
    </main>
  </div>

  {% include "partials/ui.njk" %}
</body>
</html>
