{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/product-card.njk" import productCard %}

{% block head %}<link rel="stylesheet" href="/vendor/swiper/swiper-bundle.min.css"><link rel="stylesheet" href="/vendor/photoswipe/photoswipe.css">{% endblock %}

{% block content %}
{# ================= BANNER ================= #}
{% set slides = s.home.hero_slides %}
<section class="relative" aria-label="Banner">
  <div class="swiper hero-swiper h-[78vh] min-h-[520px] max-h-[820px]" data-count="{{ slides.length }}">
    <div class="swiper-wrapper">
      {% for sl in slides %}
      <div class="swiper-slide hero-slide relative overflow-hidden">
        {% if sl.image %}
          <img src="{{ sl.image.lg }}" srcset="{{ sl.image | srcset }}" sizes="100vw" alt="{{ sl.title }}" class="hero-img absolute inset-0 h-full w-full object-cover" {{ 'fetchpriority=high' if loop.first else 'loading=lazy' }}>
          <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/25 to-transparent"></div>
        {% else %}
          <div class="hero-img absolute inset-0 bg-grain" style="background-color: color-mix(in srgb, var(--c-primary) 9%, var(--c-bg))"></div>
          <div class="absolute -right-24 top-1/2 hidden h-[560px] w-[560px] -translate-y-1/2 rounded-full border-[70px] border-primary/25 lg:block" style="box-shadow: inset 0 0 80px rgba(255,255,255,.5)"></div>
        {% endif %}
        <div class="container-x relative flex h-full items-center">
          <div class="max-w-xl {{ 'text-white' if sl.image else '' }}">
            {% if sl.eyebrow %}<p class="eyebrow {{ '!text-white/85' if sl.image }}">{{ sl.eyebrow }}</p>{% endif %}
            <h1 class="mt-4 text-balance text-[2.6rem] font-medium leading-[1.05] sm:text-6xl lg:text-7xl">{{ sl.title }}</h1>
            {% if sl.subtitle %}<p class="mt-6 max-w-md text-[16px] leading-relaxed {{ 'text-white/85' if sl.image else 'text-muted' }}">{{ sl.subtitle }}</p>{% endif %}
            {% if sl.cta_label %}
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="{{ sl.cta_url or '/san-pham' }}" class="btn {{ 'btn-light' if sl.image else 'btn-primary' }}">{{ sl.cta_label }} {{ icon('arrow-right', 'w-4 h-4') }}</a>
              {% if features.custom_request %}<a href="/thiet-ke-rieng" class="btn {{ 'border border-white/50 text-white hover:bg-white/10' if sl.image else 'btn-outline' }}">Thiết kế riêng</a>{% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% if slides.length > 1 %}<div class="swiper-pagination !bottom-8"></div>{% endif %}
  </div>
</section>

{# ================= THÔNG TIN NỔI BẬT (bấm để xem chi tiết) ================= #}
{% if s.home.info_blocks.length %}
<section class="relative z-10 -mt-14">
  <div class="container-x">
    <div class="grid grid-cols-2 overflow-hidden rounded-lg border border-line bg-surface shadow-xl shadow-ink/5 lg:grid-cols-{{ s.home.info_blocks.length if s.home.info_blocks.length <= 4 else 4 }}">
      {% for b in s.home.info_blocks %}
      <button type="button" class="reveal group flex flex-col items-start gap-3 border-line p-5 text-left transition hover:bg-primary/[.03] md:p-7 {{ 'border-r' if not loop.last }} {{ 'border-b lg:border-b-0' if loop.index <= 2 }}"
        data-title="{{ b.title }}" @click="$store.info.fromTemplate($el.dataset.title, 'info-{{ loop.index0 }}')">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary/8 text-primary transition group-hover:bg-primary group-hover:text-on-primary">{{ icon(b.icon or 'gem', 'w-5 h-5') }}</span>
        <span class="font-heading text-lg font-medium leading-tight md:text-xl">{{ b.title }}</span>
        <span class="text-[13px] leading-relaxed text-muted">{{ b.summary }}</span>
        <span class="mt-auto inline-flex items-center gap-1 text-xs font-medium text-accent">Xem thêm {{ icon('chevron-right', 'w-3.5 h-3.5') }}</span>
      </button>
      <template id="info-{{ loop.index0 }}">{{ b.detail | safe }}</template>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ================= SẢN PHẨM NỔI BẬT ================= #}
{% if featured.length %}
<section class="section">
  <div class="container-x">
    <div class="section-head reveal">
      <span class="eyebrow">Bộ sưu tập</span>
      <h2 class="section-title">{{ s.home.featured_title }}</h2>
      <p class="section-sub">{{ s.home.featured_subtitle }}</p>
      <div class="divider-ornament"></div>
    </div>
    <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 md:gap-x-6 {{ 'lg:grid-cols-4' if s.theme.product_grid == '4' else 'lg:grid-cols-3' }}">
      {% for p in featured %}{{ productCard(p, features, loop.index0) }}{% endfor %}
    </div>
    <div class="mt-14 text-center"><a href="/san-pham" class="btn btn-outline">Xem tất cả sản phẩm {{ icon('arrow-right', 'w-4 h-4') }}</a></div>
  </div>
</section>
{% endif %}

{# ================= CHỨNG CHỈ KIỂM ĐỊNH ================= #}
{% if s.home.show_certificates and (s.home.cert_items.length or s.home.cert_commitments.length) %}
<section class="section relative overflow-hidden panel-primary">
  <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full border-[60px] border-white/5"></div>
  <div class="container-x relative grid items-center gap-12 lg:grid-cols-[1fr_1.3fr]">
    <div class="reveal">
      <span class="eyebrow !text-accent">Chứng chỉ kiểm định</span>
      <h2 class="mt-3 text-3xl font-medium md:text-[2.6rem]">{{ s.home.cert_title }}</h2>
      <p class="mt-4 max-w-md opacity-80">{{ s.home.cert_subtitle }}</p>
      {% if s.home.cert_commitments.length %}
      <ul class="mt-8 space-y-4">
        {% for c in s.home.cert_commitments %}{% if c.text %}
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent">{{ icon('check', 'w-3.5 h-3.5') }}</span>
          <span class="text-[15px]">{{ c.text }}</span>
        </li>
        {% endif %}{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% if s.home.cert_items.length %}
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3" data-pswp>
      {% for c in s.home.cert_items %}
      <figure class="reveal">
        {% if c.image %}
        <a href="{{ c.image.lg }}" data-pswp-width="{{ c.image.width }}" data-pswp-height="{{ c.image.height }}" data-caption="{{ c.title }}"
          class="group relative block aspect-[3/4] overflow-hidden rounded-md bg-white shadow-xl shadow-black/20 ring-1 ring-white/20">
          <img src="{{ c.image.md }}" alt="{{ c.title }}" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
          <span class="absolute inset-0 flex items-center justify-center bg-black/0 text-white opacity-0 transition group-hover:bg-black/30 group-hover:opacity-100">{{ icon('zoom', 'w-7 h-7') }}</span>
        </a>
        {% else %}
        <div class="flex aspect-[3/4] flex-col items-center justify-center gap-3 rounded-md border border-dashed border-white/30 bg-white/5 p-4 text-center">
          {{ icon('certificate', 'w-10 h-10 text-accent') }}
          <span class="text-xs opacity-70">Tải ảnh giấy kiểm định trong Admin › Cài đặt › Trang chủ</span>
        </div>
        {% endif %}
        <figcaption class="mt-3 text-center text-sm font-medium">{{ c.title }}{% if c.description %}<span class="block text-xs font-normal opacity-70">{{ c.description }}</span>{% endif %}</figcaption>
      </figure>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{# ================= PHÂN LOẠI ================= #}
{% if jadeTypes.length %}
<section class="section bg-surface">
  <div class="container-x">
    <div class="section-head reveal">
      <span class="eyebrow">Phân loại</span>
      <h2 class="section-title">{{ s.home.categories_title }}</h2>
      <div class="divider-ornament"></div>
    </div>
    <div class="grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-{{ jadeTypes.length if jadeTypes.length <= 4 else 4 }}">
      {% for t in jadeTypes %}
      <a href="/san-pham?loai={{ t.slug }}" class="reveal group relative block aspect-[4/5] overflow-hidden rounded-lg bg-primary/10">
        {% if t.image %}
          <img src="{{ t.image.md }}" alt="{{ t.name }}" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105">
        {% else %}
          <div class="absolute inset-0 bg-grain transition duration-700 group-hover:scale-105" style="background: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--c-primary) {{ 20 + loop.index0 * 12 }}%, white), color-mix(in srgb, var(--c-primary) {{ 55 + loop.index0 * 10 }}%, black))"></div>
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-5 text-white md:p-6">
          <h3 class="text-2xl font-medium md:text-3xl">{{ t.name }}</h3>
          {% if t.description %}<p class="mt-1.5 line-clamp-2 text-[13px] text-white/80">{{ t.description }}</p>{% endif %}
          <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium uppercase tracking-[0.15em] text-white/90 transition group-hover:gap-3">Khám phá {{ icon('arrow-right', 'w-3.5 h-3.5') }}</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ================= Ý NGHĨA NGỌC & PHONG THỦY ================= #}
{% if s.home.show_fengshui and s.home.fengshui_items.length %}
<section class="section">
  <div class="container-x grid items-center gap-12 {{ 'lg:grid-cols-[1fr_1.2fr]' if s.home.fengshui_image }}">
    {% if s.home.fengshui_image %}
    <div class="reveal relative">
      <img src="{{ s.home.fengshui_image.md }}" alt="{{ s.home.fengshui_title }}" loading="lazy" class="aspect-[4/5] w-full rounded-lg object-cover">
      <div class="absolute -bottom-5 -right-5 -z-10 h-full w-full rounded-lg border border-accent/40"></div>
    </div>
    {% endif %}
    <div>
      <div class="reveal {{ 'section-head' if not s.home.fengshui_image else 'mb-10' }}">
        <span class="eyebrow">Phong thủy</span>
        <h2 class="section-title">{{ s.home.fengshui_title }}</h2>
        <p class="section-sub">{{ s.home.fengshui_subtitle }}</p>
        {% if not s.home.fengshui_image %}<div class="divider-ornament"></div>{% endif %}
      </div>
      <div class="grid gap-5 sm:grid-cols-2 {{ 'lg:grid-cols-4' if not s.home.fengshui_image }}">
        {% for f in s.home.fengshui_items %}
        <div class="reveal card p-6">
          <span class="font-heading text-4xl leading-none text-accent">{{ '0' + loop.index if loop.index < 10 else loop.index }}</span>
          <h3 class="mt-3 text-xl font-medium">{{ f.title }}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{{ f.content }}</p>
        </div>
        {% endfor %}
      </div>
      {% if jadeTypes.length %}
      <p class="reveal mt-8 text-sm text-muted {{ 'text-center' if not s.home.fengshui_image }}">Chọn ngọc hợp mệnh:
        <a href="/san-pham" class="font-medium text-primary underline decoration-accent/50 underline-offset-4 hover:decoration-accent">lọc sản phẩm theo mệnh của bạn</a></p>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# ================= SỐ ĐO NI ================= #}
{% if features.size_guide and s.size_guide.table.length %}
<section class="section">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2">
    <div class="reveal">
      <span class="eyebrow">Chọn size</span>
      <h2 class="section-title">{{ s.home.size_title }}</h2>
      <p class="section-sub max-w-md">{{ s.home.size_subtitle }}</p>
      <ol class="mt-8 space-y-5">
        {% for st in s.size_guide.steps | batch(3) | first %}
        <li class="flex gap-4">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-accent font-heading text-accent">{{ loop.index }}</span>
          <div><p class="font-medium">{{ st.title }}</p><p class="text-sm text-muted">{{ st.content }}</p></div>
        </li>
        {% endfor %}
      </ol>
      {% if s.home.show_size_calc %}
      <div class="mt-8 rounded-lg border border-line bg-surface p-5" x-data="sizeCalc({{ s.size_guide.table | attrjson }})">
        <label for="home-hand" class="label">Tính ni nhanh: nhập chu vi bàn tay (cm)</label>
        <div class="flex items-center gap-3">
          <input id="home-hand" type="number" step="0.1" min="10" max="30" x-model.number="hand" class="input !w-36" placeholder="VD: 18.5">
          <p class="text-sm" x-show="hand" x-cloak>
            <template x-if="result"><span>Ni phù hợp: <b class="font-heading text-2xl text-primary" x-text="result.size"></b> mm</span></template>
            <template x-if="!result"><span class="text-muted">Ngoài bảng, nhắn shop để tư vấn</span></template>
          </p>
        </div>
      </div>
      {% endif %}
      <a href="/huong-dan-size" class="btn btn-primary mt-8">{{ icon('ruler', 'w-4 h-4') }} Hướng dẫn chi tiết</a>
    </div>
    <div class="reveal card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-primary text-on-primary">
          <tr><th class="px-5 py-3.5 text-left font-medium">Ni (mm)</th><th class="px-5 py-3.5 text-left font-medium">Chu vi bàn tay</th><th class="hidden px-5 py-3.5 text-left font-medium sm:table-cell">Cổ tay</th></tr>
        </thead>
        <tbody>
          {% for r in s.size_guide.table %}
          <tr class="border-t border-line odd:bg-ink/[.02]">
            <td class="px-5 py-3 font-heading text-lg font-semibold text-primary">{{ r.size }}</td>
            <td class="px-5 py-3">{{ r.hand }} cm {% if r.note %}<span class="badge ml-1 bg-accent/10 text-accent">{{ r.note }}</span>{% endif %}</td>
            <td class="hidden px-5 py-3 text-muted sm:table-cell">{{ r.wrist }} cm</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}

{# ================= THIẾT KẾ RIÊNG ================= #}
{% if features.custom_request %}
<section class="section !pt-0">
  <div class="container-x">
    <div class="reveal relative grid overflow-hidden rounded-lg panel-primary lg:grid-cols-2">
      <div class="relative z-10 p-8 md:p-14">
        <span class="eyebrow !text-accent">Custom</span>
        <h2 class="mt-3 text-3xl font-medium md:text-5xl">{{ s.home.custom_title }}</h2>
        <p class="mt-5 max-w-md opacity-80">{{ s.home.custom_subtitle }}</p>
        <a href="/thiet-ke-rieng" class="btn btn-accent mt-8">{{ icon('sparkle', 'w-4 h-4') }} Gửi yêu cầu thiết kế</a>
      </div>
      {% if s.home.custom_image %}
        <img src="{{ s.home.custom_image.md }}" alt="{{ s.home.custom_title }}" loading="lazy" class="h-full max-h-[420px] w-full object-cover lg:max-h-none">
      {% else %}
        <div class="relative hidden lg:block"><div class="absolute -right-16 top-1/2 h-[420px] w-[420px] -translate-y-1/2 rounded-full border-[56px] border-white/15"></div><div class="absolute right-40 top-10 h-40 w-40 rounded-full border-[22px] border-accent/40"></div></div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{# ================= GALLERY ================= #}
{% if gallery.length %}
<section class="section bg-surface">
  <div class="container-x">
    <div class="section-head reveal">
      <span class="eyebrow">Gallery</span>
      <h2 class="section-title">{{ s.pages.gallery_title }}</h2>
      <p class="section-sub">{{ s.pages.gallery_intro }}</p>
    </div>
    {% if s.home.gallery_autoscroll and gallery.length > 8 %}
    {# Lướt tự động phải → trái; JS nhân đôi dãy ảnh để chạy vòng liên tục #}
    <div class="gallery-marquee" data-marquee style="--marquee-time: {{ s.home.gallery_scroll_seconds or 45 }}s">
      <div class="gallery-marquee-track" data-pswp>
        <div class="gallery-group">
        {% for g in gallery %}
        {% if g.product_slug %}<a href="/san-pham/{{ g.product_slug }}" @click.prevent="$store.quick.show('{{ g.product_slug }}')"{% else %}<a href="{{ g.image.lg }}" data-pswp-width="{{ g.image.width }}" data-pswp-height="{{ g.image.height }}" data-caption="{{ g.title }}"{% endif %}
          class="group relative block aspect-square overflow-hidden rounded-md">
          <img src="{{ g.image.sm }}" alt="{{ g.image.alt or g.title }}" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-105">
          <span class="absolute inset-0 flex items-center justify-center bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/30 group-hover:opacity-100">{{ icon('zoom', 'w-7 h-7') }}</span>
        </a>
        {% endfor %}
        </div>
      </div>
    </div>
    {% else %}
    <div class="pswp-gallery grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" data-pswp>
      {% for g in gallery | batch(8) | first %}
      {% if g.product_slug %}<a href="/san-pham/{{ g.product_slug }}" @click.prevent="$store.quick.show('{{ g.product_slug }}')"{% else %}<a href="{{ g.image.lg }}" data-pswp-width="{{ g.image.width }}" data-pswp-height="{{ g.image.height }}" data-caption="{{ g.title }}"{% endif %}
        class="reveal group relative block overflow-hidden rounded-md">
        <img src="{{ g.image.sm }}" alt="{{ g.image.alt or g.title }}" loading="lazy" class="aspect-square h-full w-full object-cover transition duration-700 group-hover:scale-105">
        <span class="absolute inset-0 flex items-center justify-center bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/30 group-hover:opacity-100">{{ icon('zoom', 'w-7 h-7') }}</span>
      </a>
      {% endfor %}
    </div>
    {% endif %}
    <div class="mt-10 text-center"><a href="/gallery" class="btn btn-outline">Xem thêm Gallery</a></div>
  </div>
</section>
{% endif %}

{# ================= CẢM NHẬN KHÁCH HÀNG ================= #}
{% if s.home.testimonials.length %}
<section class="section">
  <div class="container-x">
    <div class="section-head reveal"><span class="eyebrow">Khách hàng</span><h2 class="section-title">Cảm nhận từ khách hàng</h2></div>
    <div class="grid gap-6 md:grid-cols-3">
      {% for t in s.home.testimonials %}
      <figure class="reveal card p-7">
        <div class="font-heading text-5xl leading-none text-accent">“</div>
        <blockquote class="mt-2 text-[15px] leading-relaxed text-ink/85">{{ t.content }}</blockquote>
        <figcaption class="mt-5 flex items-center gap-3">
          {% if t.avatar %}<img src="{{ t.avatar.sm }}" alt="{{ t.name }}" class="h-10 w-10 rounded-full object-cover" loading="lazy">{% endif %}
          <span class="font-medium">{{ t.name }}</span>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ================= BLOG ================= #}
{% if posts.length %}
<section class="section {{ 'bg-surface' if s.home.testimonials.length }}">
  <div class="container-x">
    <div class="mb-10 flex items-end justify-between gap-4 reveal">
      <div><span class="eyebrow">Blog</span><h2 class="section-title">{{ s.pages.blog_title }}</h2></div>
      <a href="/blog" class="hidden items-center gap-1 text-sm font-medium text-primary hover:underline sm:inline-flex">Tất cả bài viết {{ icon('arrow-right', 'w-4 h-4') }}</a>
    </div>
    <div class="grid gap-8 md:grid-cols-3">
      {% for p in posts %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endblock %}

{% block scripts %}<script defer src="/vendor/swiper/swiper-bundle.min.js"></script>{% endblock %}
