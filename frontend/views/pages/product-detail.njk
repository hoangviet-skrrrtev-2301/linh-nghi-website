{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/product-card.njk" import productCard %}

{% block head %}<link rel="stylesheet" href="/vendor/swiper/swiper-bundle.min.css"><link rel="stylesheet" href="/vendor/photoswipe/photoswipe.css">{% endblock %}

{% block content %}
{% set p = product %}
<div class="container-x pt-6">
  <nav class="text-xs text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-primary">Trang chủ</a><span class="mx-1.5">/</span>
    <a href="/san-pham" class="hover:text-primary">Sản phẩm</a><span class="mx-1.5">/</span>
    {% if parent %}<a href="/san-pham/{{ parent.slug }}" class="hover:text-primary">{{ parent.name }}</a><span class="mx-1.5">/</span>{% endif %}
    <span class="text-ink">{{ p.name }}</span>
  </nav>
</div>

<section class="container-x grid gap-10 py-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16 lg:py-12"
  x-data="productBuy({{ { id: p.id, name: p.name, slug: p.slug, final_price: p.final_price if features.show_prices else none, cover: p.cover, sizes: p.sizes, sku: p.sku } | attrjson }})">

  {# ===== Ảnh ===== #}
  <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
    <div class="swiper product-main overflow-hidden rounded-lg bg-surface" data-pswp>
      <div class="swiper-wrapper">
        {% for im in p.images %}
        <a href="{{ im.lg }}" data-pswp-width="{{ im.width }}" data-pswp-height="{{ im.height }}" class="swiper-slide block aspect-square">
          <img src="{{ im.lg if loop.first else im.md }}" srcset="{{ im | srcset }}" sizes="(min-width:1024px) 55vw, 100vw" alt="{{ im.alt or p.name }}"
            width="{{ im.width }}" height="{{ im.height }}" class="h-full w-full object-cover" {{ 'fetchpriority=high' if loop.first else 'loading=lazy' }}>
        </a>
        {% endfor %}
      </div>
      <span class="pointer-events-none absolute bottom-4 right-4 z-10 flex items-center gap-1.5 rounded-full bg-surface/85 px-3 py-1.5 text-xs backdrop-blur">{{ icon('zoom', 'w-3.5 h-3.5') }} Bấm để phóng to</span>
    </div>
    {% if p.images.length > 1 %}
    <div class="swiper product-thumbs mt-3">
      <div class="swiper-wrapper">
        {% for im in p.images %}
        <div class="swiper-slide !w-20 cursor-pointer overflow-hidden rounded-md opacity-60 transition [&.swiper-slide-thumb-active]:opacity-100 [&.swiper-slide-thumb-active]:ring-2 [&.swiper-slide-thumb-active]:ring-primary">
          <img src="{{ im.sm }}" alt="" width="{{ im.width }}" height="{{ im.height }}" class="aspect-square w-full object-cover" loading="lazy" decoding="async">
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>

  {# ===== Thông tin ===== #}
  <div class="min-w-0">
    {% if p.jade_type %}<p class="eyebrow">{{ p.jade_type.name }}</p>{% endif %}
    <h1 class="mt-3 text-4xl font-medium leading-tight md:text-5xl">{{ p.name }}</h1>
    {% if p.sku %}<p class="mt-2 text-xs text-muted">Mã: {{ p.sku }}</p>{% endif %}

    {% if features.show_prices %}
    <div class="mt-5 flex items-baseline gap-3">
      {% if p.final_price != null %}
        <span class="price text-3xl">{{ p.final_price | vnd }}</span>
        {% if p.on_sale %}<span class="price-old text-base">{{ p.price | vnd }}</span><span class="tag tag-sale">-{{ ((1 - p.sale_price / p.price) * 100) | round }}%</span>{% endif %}
      {% else %}
        <span class="price text-2xl">Giá liên hệ</span>
      {% endif %}
    </div>
    {% endif %}

    <div class="mt-4 flex flex-wrap gap-2">
      {% if p.is_bestseller %}<span class="tag tag-bestseller">★ Best Seller</span>{% endif %}
      {% if p.show_new %}<span class="tag tag-new">Mới</span>{% endif %}
      <span class="badge {{ 'bg-emerald-50 text-emerald-700' if p.stock_status == 'in_stock' else ('bg-amber-50 text-amber-700' if p.stock_status == 'made_to_order' else 'bg-ink/5 text-muted') }}">{{ p.stock_label }}</span>
      {% if p.certificates.length %}<span class="badge bg-primary/10 text-primary">{{ icon('shield', 'w-3 h-3 mr-1') }} Có kiểm định</span>{% endif %}
      {% if p.is_customizable %}<span class="tag tag-custom">Có thể custom</span>{% endif %}
    </div>

    {% if p.short_description %}<p class="mt-6 text-[15.5px] leading-relaxed text-muted">{{ p.short_description }}</p>{% endif %}

    {% if p.sizes.length %}
    <div class="mt-8">
      <div class="flex items-center justify-between">
        <p class="label !mb-0">Ni tay (mm) <span class="font-normal text-muted" x-show="chosenSize" x-text="'· đã chọn ' + chosenSize"></span></p>
        {% if features.size_guide %}<a href="/huong-dan-size" class="inline-flex items-center gap-1 text-xs text-accent hover:underline">{{ icon('ruler', 'w-3.5 h-3.5') }} Hướng dẫn đo</a>{% endif %}
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        {% for sz in p.sizes %}
        <button type="button" class="chip min-w-14 justify-center" :class="size === {{ sz }} && '!border-primary !bg-primary !text-on-primary'" @click="size = {{ sz }}">{{ sz }}</button>
        {% endfor %}
        <button type="button" class="chip" :class="size === 'other' && '!border-primary !bg-primary !text-on-primary'" @click="size = 'other'; $nextTick(() => $refs.otherSize.focus())">Ni khác</button>
      </div>
      <div x-show="size === 'other'" x-cloak x-transition class="mt-3">
        <input x-ref="otherSize" x-model.trim="customSize" maxlength="20" class="input !w-64" placeholder="Nhập ni hoặc chu vi tay, VD: 55" aria-label="Nhập ni tay riêng">
        <p class="mt-1 text-xs text-muted">Shop sẽ tìm ngọc đúng ni hoặc tư vấn ni phù hợp nhất cho bạn.</p>
      </div>
    </div>
    {% endif %}

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      {% if features.checkout and p.stock_status != 'sold_out' %}
      <div class="flex items-center justify-between rounded-md border border-line bg-surface">
        <button type="button" class="px-3.5 py-3 text-muted hover:text-ink" @click="qty = Math.max(1, qty - 1)" aria-label="Giảm">{{ icon('minus', 'w-4 h-4') }}</button>
        <span class="w-8 text-center font-medium" x-text="qty">1</span>
        <button type="button" class="px-3.5 py-3 text-muted hover:text-ink" @click="qty = Math.min(20, qty + 1)" aria-label="Tăng">{{ icon('plus', 'w-4 h-4') }}</button>
      </div>
      <button type="button" class="btn btn-primary flex-1" @click="addToCart()">{{ icon('bag', 'w-4 h-4') }} Thêm vào giỏ hàng</button>
      <button type="button" class="btn btn-accent flex-1" @click="quickOrder()">Đặt nhanh</button>
      {% else %}
      <a href="https://zalo.me/{{ s.site.zalo | phoneHref }}" target="_blank" rel="noopener" class="btn btn-primary flex-1">{{ icon('chat', 'w-4 h-4') }} Nhắn Zalo tư vấn</a>
      {% endif %}
    </div>
    <div class="mt-3 grid grid-cols-2 gap-3">
      <button type="button" class="btn btn-outline" @click="consult()">{{ icon('mail', 'w-4 h-4') }} Yêu cầu tư vấn</button>
      <a href="tel:{{ s.site.phone | phoneHref }}" class="btn btn-outline">{{ icon('phone', 'w-4 h-4') }} Gọi shop</a>
    </div>
    {% if p.is_customizable and features.custom_request %}
    <a href="/thiet-ke-rieng?mau={{ p.name | urlencode }}" class="mt-3 flex items-center justify-center gap-2 rounded-md border border-dashed border-accent/60 px-4 py-3 text-sm text-accent transition hover:bg-accent/5">
      {{ icon('sparkle', 'w-4 h-4') }} Muốn đổi loại ngọc, màu, kích thước? Gửi yêu cầu custom mẫu này
    </a>
    {% endif %}

    {# ----- Thông số ----- #}
    <dl class="mt-10 divide-y divide-line border-y border-line text-sm">
      {% set rows = [
        ['Loại ngọc', p.jade_type.name if p.jade_type else ''],
        ['Màu sắc', p.color.name if p.color else ''],
        ['Kiểu dáng', p.style.name if p.style else ''],
        ['Hợp mệnh', p.elements | join(', ', 'name')],
        ['Ni có sẵn', (p.sizes | join(', ')) + ' mm' if p.sizes.length else ''],
        ['Kích thước hạt', p.bead_size],
        ['Xuất xứ', p.origin],
        ['Trọng lượng', p.weight]
      ] %}
      {% for r in rows %}{% if r[1] %}<div class="grid grid-cols-[140px_1fr] gap-4 py-3"><dt class="text-muted">{{ r[0] }}</dt><dd class="font-medium">{{ r[1] }}</dd></div>{% endif %}{% endfor %}
      {# Thông số tự đặt của loại sản phẩm (ví dụ Pháp phục: chất liệu, kích cỡ...) #}
      {% for sv in p.spec_values %}<div class="grid grid-cols-[140px_1fr] gap-4 py-3"><dt class="text-muted">{{ sv.label }}</dt><dd class="font-medium">{{ sv.value }}</dd></div>{% endfor %}
      {% for sp in p.specs %}<div class="grid grid-cols-[140px_1fr] gap-4 py-3"><dt class="text-muted">{{ sp.label }}</dt><dd class="font-medium">{{ sp.value }}</dd></div>{% endfor %}
    </dl>

    {# ----- Chứng chỉ kiểm định ----- #}
    {% if p.certificates.length %}
    <div class="mt-10">
      <h2 class="flex items-center gap-2 text-2xl font-medium">{{ icon('certificate', 'w-6 h-6 text-primary') }} Chứng chỉ kiểm định</h2>
      <div class="mt-5 space-y-4" data-pswp>
        {% for c in p.certificates %}
        <div class="card flex gap-4 p-4">
          {% if c.image %}
          <a href="{{ c.image.lg }}" data-pswp-width="{{ c.image.width }}" data-pswp-height="{{ c.image.height }}" class="block w-28 shrink-0 overflow-hidden rounded-md border border-line sm:w-36">
            <img src="{{ c.image.sm }}" alt="Chứng chỉ {{ c.code }}" width="{{ c.image.width }}" height="{{ c.image.height }}" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async">
          </a>
          {% endif %}
          <dl class="grid flex-1 gap-1.5 text-sm">
            {% if c.issuer %}<div><dt class="inline text-muted">Nơi cấp:</dt> <dd class="inline font-medium">{{ c.issuer }}</dd></div>{% endif %}
            {% if c.code %}<div><dt class="inline text-muted">Mã số:</dt> <dd class="inline font-mono font-medium">{{ c.code }}</dd></div>{% endif %}
            {% if c.issued_date %}<div><dt class="inline text-muted">Ngày cấp:</dt> <dd class="inline">{{ c.issued_date }}</dd></div>{% endif %}
            {% if c.note %}<p class="text-muted">{{ c.note }}</p>{% endif %}
          </dl>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if p.description %}
    <div class="mt-10">
      <h2 class="text-2xl font-medium">Mô tả sản phẩm</h2>
      <div class="prose-jade mt-4">{{ p.description | headings(2) | imgdims | safe }}</div>
    </div>
    {% endif %}

    {% if p.fengshui or p.elements.length %}
    <div class="mt-10 rounded-lg border border-accent/30 bg-accent/5 p-6">
      <h2 class="flex items-center gap-2 text-2xl font-medium">{{ icon('sparkle', 'w-5 h-5 text-accent') }} Ý nghĩa phong thủy</h2>
      {% if p.elements.length %}<p class="mt-3 text-sm">Hợp mệnh: {% for e in p.elements %}<a href="/san-pham?menh={{ e.slug }}" class="badge mr-1 bg-surface text-primary ring-1 ring-line hover:ring-primary">{{ e.name }}</a>{% endfor %}</p>{% endif %}
      {% if p.fengshui %}<p class="mt-3 text-[15px] leading-relaxed text-ink/85">{{ p.fengshui | nl2br }}</p>{% endif %}
    </div>
    {% endif %}

    {% if s.pages.product_care %}
    <details class="group mt-6 rounded-lg border border-line bg-surface p-6" open>
      <summary class="flex cursor-pointer list-none items-center justify-between text-xl font-medium font-heading">Hướng dẫn bảo quản <span class="transition group-open:rotate-180">{{ icon('chevron-down', 'w-5 h-5') }}</span></summary>
      <div class="prose-jade mt-4 text-[15px]">{{ s.pages.product_care | headings(2) | imgdims | safe }}</div>
    </details>
    {% endif %}
  </div>
</section>

{% if related.length %}
<section class="section border-t border-line">
  <div class="container-x">
    <div class="section-head"><span class="eyebrow">Có thể bạn thích</span><h2 class="section-title">Sản phẩm liên quan</h2></div>
    <div class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4 md:gap-x-6">
      {% for r in related %}{{ productCard(r, features, 9) }}{% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endblock %}

{% block scripts %}<script defer src="/vendor/swiper/swiper-bundle.min.js"></script>{% endblock %}
