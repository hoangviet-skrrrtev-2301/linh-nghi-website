{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}
{% block head %}<link rel="stylesheet" href="/vendor/photoswipe/photoswipe.css">{% endblock %}

{% block content %}
<section class="border-b border-line bg-surface">
  <div class="container-x py-12 text-center md:py-16">
    <span class="eyebrow">Gallery</span>
    <h1 class="mt-3 text-4xl font-medium md:text-5xl">{{ s.pages.gallery_title }}</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">{{ s.pages.gallery_intro }}</p>
    {% if albums.length %}
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/gallery" class="chip {{ '!border-primary !bg-primary !text-on-primary' if not album }}">Tất cả</a>
      {% for a in albums %}<a href="/gallery?album={{ a.album | urlencode }}" class="chip {{ '!border-primary !bg-primary !text-on-primary' if album == a.album }}">{{ a.album }} <span class="text-[11px] opacity-60">{{ a.count }}</span></a>{% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<section class="container-x py-12">
  {% if items.length %}
  <div class="columns-2 gap-3 md:columns-3 md:gap-5 lg:columns-4" data-pswp>
    {% for g in items %}
    <figure class="reveal group mb-3 break-inside-avoid md:mb-5">
      {% if g.product_slug %}<a href="/san-pham/{{ g.product_slug }}" @click.prevent="$store.quick.show('{{ g.product_slug }}')"{% else %}<a href="{{ g.image.lg }}" data-pswp-width="{{ g.image.width }}" data-pswp-height="{{ g.image.height }}" data-caption="{{ g.title }}{{ ' – ' + g.caption if g.caption }}"{% endif %}
        class="relative block overflow-hidden rounded-md bg-ink/5">
        <img src="{{ g.image.md }}" alt="{{ g.image.alt or g.title }}" width="{{ g.image.width }}" height="{{ g.image.height }}" loading="lazy" class="w-full transition duration-700 group-hover:scale-105">
        <span class="absolute inset-0 flex items-center justify-center bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/30 group-hover:opacity-100">{{ icon('zoom', 'w-7 h-7') }}</span>
      </a>
      {% if g.title or g.product_slug %}
      <figcaption class="mt-2 flex items-center justify-between gap-2 px-0.5 text-sm">
        <span class="truncate">{{ g.title }}</span>
        {% if g.product_slug %}<a href="/san-pham/{{ g.product_slug }}" class="shrink-0 text-xs text-accent hover:underline">Xem mẫu</a>{% endif %}
      </figcaption>
      {% endif %}
    </figure>
    {% endfor %}
  </div>
  {% else %}
  <p class="py-20 text-center text-muted">Chưa có ảnh trong mục này.</p>
  {% endif %}
</section>
{% endblock %}
