{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}

{% block content %}
{% set a = s.about %}
<section class="relative overflow-hidden bg-surface">
  <div class="container-x grid items-center gap-12 py-14 md:py-20 lg:grid-cols-2">
    <div class="reveal">
      <span class="eyebrow">Về {{ s.site.name }}</span>
      <h1 class="mt-3 text-4xl font-medium leading-tight md:text-6xl">{{ a.title }}</h1>
      {% if s.site.slogan %}<p class="mt-5 font-heading text-2xl italic text-accent">“{{ s.site.slogan }}”</p>{% endif %}
      <p class="mt-6 max-w-lg text-[16px] leading-relaxed text-muted">{{ a.intro }}</p>
    </div>
    <div class="reveal relative">
      {% if a.image %}
        <img src="{{ a.image.lg }}" srcset="{{ a.image | srcset }}" sizes="(min-width:1024px) 50vw, 100vw" alt="{{ a.title }}" class="aspect-[4/5] w-full rounded-lg object-cover lg:aspect-[5/6]">
      {% else %}
        <div class="aspect-[4/5] w-full rounded-lg bg-grain lg:aspect-[5/6]" style="background-color: color-mix(in srgb, var(--c-primary) 12%, var(--c-bg))"></div>
      {% endif %}
      <div class="absolute -bottom-6 -left-6 -z-0 hidden h-40 w-40 rounded-full border-[18px] border-accent/30 lg:block"></div>
    </div>
  </div>
</section>

{% if a.content %}
<section class="section">
  <div class="container-x max-w-3xl"><div class="prose-jade reveal">{{ a.content | safe }}</div></div>
</section>
{% endif %}

{% if a.values.length %}
<section class="section bg-primary text-on-primary">
  <div class="container-x">
    <div class="section-head"><span class="eyebrow">Giá trị</span><h2 class="section-title">Điều chúng tôi theo đuổi</h2></div>
    <div class="grid gap-6 md:grid-cols-{{ a.values.length if a.values.length <= 4 else 3 }}">
      {% for v in a.values %}
      <div class="reveal rounded-lg border border-white/15 p-8">
        <span class="font-heading text-5xl text-accent">0{{ loop.index }}</span>
        <h3 class="mt-4 text-2xl font-medium">{{ v.title }}</h3>
        <p class="mt-2 opacity-75">{{ v.content }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section text-center">
  <div class="container-x">
    <h2 class="text-3xl font-medium md:text-4xl">Tìm chiếc vòng dành cho bạn</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/san-pham" class="btn btn-primary">Xem sản phẩm</a>
      <a href="/lien-he" class="btn btn-outline">Liên hệ shop</a>
    </div>
  </div>
</section>
{% endblock %}
