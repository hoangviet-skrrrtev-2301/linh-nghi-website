{% from "partials/icons.njk" import icon %}
{% from "partials/product-card.njk" import productCard %}
{# ================= CHỨNG CHỈ KIỂM ĐỊNH ================= #}
{% if s.home.show_certificates and (s.home.cert_items.length or s.home.cert_commitments.length) %}
<section class="section relative overflow-hidden panel-primary">
  <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full border-[60px] border-white/5"></div>
  <div class="container-x relative grid items-center gap-12 lg:grid-cols-[1fr_1.3fr]">
    <div class="reveal">
      <span class="eyebrow !text-accent">Chứng chỉ kiểm định</span>
      <h2 class="mt-3 text-3xl font-medium md:text-[2.6rem]">{{ s.home.cert_title }}</h2>
      <p class="mt-4 max-w-md opacity-80">{{ s.home.cert_subtitle }}</p>
      {% if s.home.cert_commitments.length %}
      <ul class="mt-8 space-y-4">
        {% for c in s.home.cert_commitments %}{% if c.text %}
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent">{{ icon('check', 'w-3.5 h-3.5') }}</span>
          <span class="text-[15px]">{{ c.text }}</span>
        </li>
        {% endif %}{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% if s.home.cert_items.length %}
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3" data-pswp>
      {% for c in s.home.cert_items %}
      <figure class="reveal">
        {% if c.image %}
        <a href="{{ c.image.lg }}" data-pswp-width="{{ c.image.width }}" data-pswp-height="{{ c.image.height }}" data-caption="{{ c.title }}"
          class="group relative block aspect-[3/4] overflow-hidden rounded-md bg-white shadow-xl shadow-black/20 ring-1 ring-white/20">
          <img src="{{ c.image.md }}" srcset="{{ c.image | srcset }}" sizes="(min-width:1024px) 22vw, (min-width:640px) 30vw, calc(50vw - 24px)" alt="{{ c.title }}" width="{{ c.image.width }}" height="{{ c.image.height }}" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
          <span class="absolute inset-0 flex items-center justify-center bg-black/0 text-white opacity-0 transition group-hover:bg-black/30 group-hover:opacity-100">{{ icon('zoom', 'w-7 h-7') }}</span>
        </a>
        {% else %}
        <div class="flex aspect-[3/4] flex-col items-center justify-center gap-3 rounded-md border border-dashed border-white/30 bg-white/5 p-4 text-center">
          {{ icon('certificate', 'w-10 h-10 text-accent') }}
          <span class="text-xs opacity-70">Tải ảnh giấy kiểm định trong Admin › Cài đặt › Trang chủ</span>
        </div>
        {% endif %}
        <figcaption class="mt-3 text-center text-sm font-medium">{{ c.title }}{% if c.description %}<span class="block text-xs font-normal opacity-70">{{ c.description }}</span>{% endif %}</figcaption>
      </figure>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}
