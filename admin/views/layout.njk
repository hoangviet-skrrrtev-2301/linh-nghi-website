{% from "partials/icons.njk" import icon %}
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <script nonce="{{ nonce }}">
    (function () {
      var t = null;
      try { t = localStorage.getItem('ln_admin_theme'); } catch (e) {}
      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
  <meta name="csrf-token" content="{{ csrfToken }}">
  <meta name="admin-path" content="{{ A }}">
  <title>{% block title %}Quản trị{% endblock %} · {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/admin-assets/css/admin.css?v={{ assetVersion }}">
  {% block head %}{% endblock %}
  <script type="application/json" id="admin-meta">{{ meta | jsonScript }}</script>
  <script type="application/json" id="admin-user">{{ currentUser | jsonScript }}</script>
  <link rel="stylesheet" href="/vendor/quill/quill.snow.css">
  <script defer src="/admin-assets/js/core.js?v={{ assetVersion }}"></script>
  <script defer src="/admin-assets/js/pages.js?v={{ assetVersion }}"></script>
  {% block scripts %}{% endblock %}
  <script defer src="/vendor/alpine-sort/cdn.min.js"></script>
  <script defer src="/vendor/alpine-collapse/cdn.min.js"></script>
  <script defer src="/vendor/alpine-focus/cdn.min.js"></script>
  <script defer src="/vendor/alpine/cdn.min.js"></script>
</head>
<body x-data="{ sidebar: false }" class="min-h-screen">
  {# ============ Thanh bên ============ #}
  <div x-cloak x-show="sidebar" class="fixed inset-0 z-40 bg-slate-900/50 lg:hidden" @click="sidebar = false"></div>
  <aside :class="sidebar ? 'translate-x-0' : '-translate-x-full'" class="fixed inset-y-0 left-0 z-50 flex w-64 flex-col bg-slate-900 transition-transform lg:translate-x-0">
    <div class="flex h-16 items-center gap-3 border-b border-white/10 px-5">
      {# Biểu tượng = logo của website (bản sáng cho nền tối nếu có), chưa có logo thì dùng biểu tượng kim cương #}
      {% set brandImg = shop.logo_light or shop.logo or shop.favicon %}
      {% if brandImg %}<img src="{{ brandImg.sm }}" alt="" class="h-10 w-10 shrink-0 object-contain">
      {% else %}<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white">{{ icon('gem', 'w-5 h-5') }}</span>{% endif %}
      <div class="min-w-0"><p class="truncate text-sm font-semibold text-white">{{ shop.name }}</p><p class="text-[11px] text-slate-400">Trang quản trị</p></div>
    </div>
    {% set p = currentPath %}
    {% macro link(href, label, ic, active) %}{% from "partials/icons.njk" import icon %}<a href="{{ href }}" class="nav-link {{ 'active' if active }}">{{ icon(ic, 'w-[18px] h-[18px]') }} {{ label }}</a>{% endmacro %}
    <nav class="flex-1 overflow-y-auto px-3 py-4">
      {# Mục menu chỉ hiện khi tài khoản có quyền tương ứng (backend/config/permissions.js).
         Mỗi nhóm chính thu gọn, chỉ xổ ra khi đang dùng một trang của nhóm đó hoặc khi bấm vào tên nhóm. #}
      {% set salesOn = p.startsWith('/inquiries') or p.startsWith('/customers') %}
      {% set catalogOn = p.startsWith('/products') or p.startsWith('/terms') or p.startsWith('/preview') %}
      {% set contentOn = p.startsWith('/gallery') or p.startsWith('/posts') or p.startsWith('/authors') or p.startsWith('/media') %}
      {% set systemOn = p.startsWith('/settings') or p.startsWith('/redirects') or p.startsWith('/users') or p.startsWith('/roles') or p.startsWith('/audit') %}
      {% macro groupHead(id, label, on) %}{% from "partials/icons.njk" import icon %}<button type="button" class="nav-section nav-section-btn" @click="toggle()" :aria-expanded="open" aria-controls="nav-{{ id }}"><span>{{ label }}</span><span class="transition" :class="open && 'rotate-180'">{{ icon('chevron-down', 'w-3.5 h-3.5') }}</span></button>{% endmacro %}

      {% if can('orders') %}{{ link(A, 'Tổng quan', 'home', p == '/') }}{% endif %}

      {% if can('orders') or can('customers') %}
      <div x-data="navGroup({{ 'true' if salesOn else 'false' }})">
        {{ groupHead('sales', 'Bán hàng') }}
        <div id="nav-sales" x-show="open" {{ '' if salesOn else 'x-cloak' }} x-collapse>
          {% if can('orders') %}
          {{ link(A + '/inquiries?type=order', 'Đơn hàng', 'bag', p.startsWith('/inquiries') and query.type == 'order') }}
          {{ link(A + '/inquiries?type=custom', 'Yêu cầu custom', 'sparkle', p.startsWith('/inquiries') and query.type == 'custom') }}
          {{ link(A + '/inquiries?type=contact', 'Liên hệ', 'mail', p.startsWith('/inquiries') and query.type == 'contact') }}
          {% endif %}
          {{ link(A + '/customers', 'Khách hàng', 'users', p.startsWith('/customers')) }}
        </div>
      </div>
      {% endif %}

      {% if can('products') or can('terms') %}
      <div x-data="navGroup({{ 'true' if catalogOn else 'false' }})">
        {{ groupHead('catalog', 'Sản phẩm') }}
        <div id="nav-catalog" x-show="open" {{ '' if catalogOn else 'x-cloak' }} x-collapse>
          {% if can('products') %}{{ link(A + '/products', 'Sản phẩm', 'box', p.startsWith('/products')) }}{% endif %}
          {% if can('terms') %}{{ link(A + '/terms', 'Danh mục & bộ lọc', 'tag', p.startsWith('/terms')) }}{% endif %}
        </div>
      </div>
      {% endif %}

      {% if can('gallery') or can('posts') or can('media') or can('products') or can('terms') %}
      <div x-data="navGroup({{ 'true' if contentOn else 'false' }})">
        {{ groupHead('content', 'Nội dung') }}
        <div id="nav-content" x-show="open" {{ '' if contentOn else 'x-cloak' }} x-collapse>
          {% if can('gallery') %}{{ link(A + '/gallery', 'Gallery', 'image', p.startsWith('/gallery')) }}{% endif %}
          {% if can('posts') %}
          {{ link(A + '/posts', 'Blog', 'doc', p.startsWith('/posts')) }}
          {{ link(A + '/authors', 'Tác giả blog', 'user', p.startsWith('/authors')) }}
          {% endif %}
          {{ link(A + '/media', 'Thư viện ảnh', 'folder', p.startsWith('/media')) }}
        </div>
      </div>
      {% endif %}

      {% if can('settings_site') or can('settings_pages') or can('settings_design') or can('settings_seo') or can('mail') or can('redirects') or can('audit') or currentUser.role == 'owner' %}
      <div x-data="navGroup({{ 'true' if systemOn else 'false' }})">
        {{ groupHead('system', 'Hệ thống') }}
        <div id="nav-system" x-show="open" {{ '' if systemOn else 'x-cloak' }} x-collapse>
          {% if can('settings_site') or can('settings_pages') or can('settings_design') or can('settings_seo') or can('mail') %}{{ link(A + '/settings', 'Cài đặt website', 'settings', p.startsWith('/settings')) }}{% endif %}
          {% if can('redirects') %}{{ link(A + '/redirects', 'Chuyển hướng & 404', 'external', p.startsWith('/redirects')) }}{% endif %}
          {% if currentUser.role == 'owner' %}
          {{ link(A + '/users', 'Tài khoản quản trị', 'shield', p.startsWith('/users')) }}
          {{ link(A + '/roles', 'Vai trò & phân quyền', 'shield', p.startsWith('/roles')) }}
          {% endif %}
          {% if can('audit') %}{{ link(A + '/audit', 'Nhật ký hoạt động', 'clock', p.startsWith('/audit')) }}{% endif %}
        </div>
      </div>
      {% endif %}
    </nav>
    <div class="border-t border-white/10 p-3">
      <a href="/" target="_blank" rel="noopener" class="nav-link">{{ icon('external', 'w-[18px] h-[18px]') }} Xem website</a>
    </div>
  </aside>

  {# ============ Nội dung ============ #}
  <div class="lg:pl-64">
    <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/90 px-4 backdrop-blur md:px-8">
      <button class="btn btn-ghost -ml-2 lg:hidden" @click="sidebar = true" aria-label="Menu">{{ icon('menu') }}</button>
      {# Nút quay lại: về đúng trang vừa xem; nếu mở thẳng bằng đường dẫn (không có trang trước trong admin) thì về danh sách của mục này #}
      {% if p != '/' %}<button type="button" class="btn btn-ghost -ml-1 shrink-0 !px-2" @click="Admin.goBack('{{ A }}/{{ p.split('/')[1] }}')" aria-label="Quay lại trang trước" title="Quay lại trang trước">{{ icon('arrow-left', 'w-5 h-5') }}<span class="hidden text-sm sm:inline">Quay lại</span></button>{% endif %}
      <h1 class="truncate text-base font-semibold">{% block heading %}{% endblock %}</h1>
      <div class="ml-auto flex items-center gap-2" x-data="{ open: false }">
        <button class="btn btn-ghost" @click="$store.theme.toggle()" :aria-label="$store.theme.dark ? 'Chuyển sang giao diện sáng' : 'Chuyển sang giao diện tối'" :title="$store.theme.dark ? 'Giao diện sáng' : 'Giao diện tối'">
          <span x-show="!$store.theme.dark">{{ icon('moon') }}</span><span x-cloak x-show="$store.theme.dark">{{ icon('sun') }}</span>
        </button>
        <button class="flex items-center gap-2 rounded-lg px-2 py-1.5 hover:bg-slate-100" @click="open = !open" @click.outside="open = false">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">{{ currentUser.name | first | upper }}</span>
          <span class="hidden text-left sm:block"><span class="block text-sm font-medium leading-tight">{{ currentUser.name }}</span><span class="block text-[11px] text-slate-500">{{ currentUser.role_label }}</span></span>
          {{ icon('chevron-down', 'w-4 h-4 text-slate-400') }}
        </button>
        <div x-cloak x-show="open" x-transition class="absolute right-4 top-14 w-52 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg md:right-8">
          <a href="{{ A }}/account" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-50">{{ icon('user', 'w-4 h-4') }} Tài khoản & bảo mật</a>
          <form method="post" action="{{ A }}/logout">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50">{{ icon('logout', 'w-4 h-4') }} Đăng xuất</button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl p-4 md:p-8">
      {% block content %}{% endblock %}
    </main>
  </div>

  {% include "partials/ui.njk" %}
</body>
</html>
