{% extends "layouts/base.njk" %}
{% block content %}
<section class="border-b border-line bg-surface {{ bg.page_head.pattern }}" style="{{ bg.page_head.style }}">
  <div class="container-x py-12 text-center md:py-16">
    <span class="eyebrow">{{ 'Chuyên mục' if category else 'Blog' }}</span>
    <h1 class="mt-3 text-4xl font-medium md:text-5xl">{{ blogName }}</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">{{ blogIntro }}</p>
    {% if blogCategories.length %}
    <nav class="mt-8 flex flex-wrap justify-center gap-2" aria-label="{{ s.pages.blog_categories_title }}">
      <a href="/blog" class="chip {{ '!border-primary !bg-primary !text-on-primary' if not category }}">Tất cả</a>
      {% for c in blogCategories %}<a href="/blog/{{ c.slug }}" class="chip {{ '!border-primary !bg-primary !text-on-primary' if category and category.id == c.id }}">{{ c.name }} <span class="text-[11px] opacity-60">{{ c.post_count }}</span></a>{% endfor %}
    </nav>
    {% endif %}
  </div>
</section>
<section class="container-x py-14">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
    <div class="min-w-0">
      {% if result.items.length %}
      <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2">
        {% set hTag = 'h2' %}{% for p in result.items %}{% include "partials/post-card.njk" %}{% endfor %}
      </div>
      {% set pg = result %}{% include "partials/pagination.njk" %}
      {% else %}
      <p class="py-20 text-center text-muted">{{ 'Chưa có bài viết trong chuyên mục này.' if category else 'Chưa có bài viết nào.' }}</p>
      {% endif %}
    </div>
    <div class="lg:sticky lg:top-[calc(var(--header-h)+1rem)] lg:self-start">
      {% include "partials/blog-sidebar.njk" %}
    </div>
  </div>
</section>
{% endblock %}
