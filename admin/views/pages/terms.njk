{% extends "layout.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/fields.njk" import imageField, switch %}
{% block title %}Danh mục & bộ lọc{% endblock %}
{% block heading %}Danh mục & bộ lọc{% endblock %}
{% block content %}
<div x-data="termsPage">
  {% set helpKey = 'terms' %}{% include "partials/page-help.njk" %}
  <p class="mb-5 max-w-3xl text-sm text-slate-600">Các danh mục dưới đây dùng để phân loại sản phẩm và tạo bộ lọc trên trang Sản phẩm. Loại ngọc còn hiển thị ở khối “Phân loại” trên trang chủ.</p>
  <div class="mb-5 flex flex-wrap items-center gap-2">
    {% for k, v in meta.termTypes %}
    <button class="tab" :class="type === '{{ k }}' && 'active'" @click="type = '{{ k }}'">{{ v }} <span class="ml-1 text-xs text-slate-400" x-text="(terms['{{ k }}'] || []).length"></span></button>
    {% endfor %}
    <button class="btn btn-primary ml-auto" @click="open()">{{ icon('plus', 'w-4 h-4') }} Thêm mục</button>
  </div>

  <div class="card overflow-hidden">
    <table class="table table-stack">
      <thead><tr><th class="w-14"></th><th class="stack-title">Tên</th><th>Đường dẫn</th><th>Thứ tự</th><th>Hiển thị</th><th class="w-24"></th></tr></thead>
      <tbody>
        <template x-for="t in list" :key="t.id">
          <tr>
            <td>
              <template x-if="t.image"><img :src="t.image.sm" class="h-10 w-10 rounded-lg object-cover" alt=""></template>
              <template x-if="!t.image && t.color_hex"><span class="block h-8 w-8 rounded-full ring-1 ring-slate-200" :style="'background:' + t.color_hex"></span></template>
            </td>
            <td><p class="font-medium" x-text="t.name"></p><p class="line-clamp-1 text-xs text-slate-500" x-text="t.description"></p></td>
            <td class="font-mono text-xs text-slate-500" x-text="t.slug"></td>
            <td x-text="t.sort_order"></td>
            <td><span class="badge" :class="t.active ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500'" x-text="t.active ? 'Hiện' : 'Ẩn'"></span></td>
            <td class="whitespace-nowrap text-right">
              <button class="btn btn-ghost btn-sm" @click="open(t)">{{ icon('edit', 'w-4 h-4') }}</button>
              <button class="btn btn-ghost btn-sm text-red-600" @click="remove(t)">{{ icon('trash', 'w-4 h-4') }}</button>
            </td>
          </tr>
        </template>
        <tr x-show="!list.length"><td colspan="6" class="py-12 text-center text-slate-500">Chưa có mục nào.</td></tr>
      </tbody>
    </table>
  </div>

  {# Popup thêm / sửa #}
  <div x-cloak x-show="editing" class="fixed inset-0 z-[80] flex items-center justify-center p-4" @keydown.escape.window="editing = null">
    <div class="absolute inset-0 bg-slate-900/50" @click="editing = null"></div>
    <template x-if="editing">
      <form @submit.prevent="save()" class="card relative w-full max-w-lg">
        <div class="card-head"><h3 class="card-title" x-text="editing.id ? 'Sửa mục' : 'Thêm mục mới'"></h3><button type="button" class="btn btn-ghost btn-sm" @click="editing = null">{{ icon('close', 'w-4 h-4') }}</button></div>
        <div class="card-body space-y-4">
          <div><label class="label">Tên *</label><input class="input" x-model="editing.name" required></div>
          <div><label class="label">Đường dẫn (tự tạo nếu để trống)</label><input class="input font-mono" x-model="editing.slug"></div>
          <div><label class="label">Mô tả</label><textarea class="input" rows="2" x-model="editing.description"></textarea></div>
          <div class="grid grid-cols-2 gap-4">
            <div x-show="type === 'color'"><label class="label">Mã màu</label><div class="flex gap-2"><input type="color" class="h-10 w-12 rounded border border-slate-300" x-model="editing.color_hex"><input class="input font-mono" x-model="editing.color_hex" placeholder="#3f8f6b"></div></div>
            <div><label class="label">Thứ tự</label><input type="number" class="input" x-model.number="editing.sort_order"></div>
          </div>
          <div x-show="type === 'jade_type'"><label class="label">Ảnh đại diện (khối Phân loại trang chủ)</label>{{ imageField('editing.media_id', 'editing.image') }}</div>
          {{ switch('editing.active', 'Hiển thị trên website') }}
        </div>
        <div class="flex justify-end gap-2 border-t border-slate-100 px-5 py-3">
          <button type="button" class="btn btn-secondary" @click="editing = null">Hủy</button>
          <button class="btn btn-primary" :disabled="saving">Lưu</button>
        </div>
      </form>
    </template>
  </div>
</div>
{% endblock %}
