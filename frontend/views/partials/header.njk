{% from "partials/icons.njk" import icon %}
{% if features.announcement %}
<div class="panel-primary text-center text-[12.5px] tracking-wide py-2 px-4 {{ bg.announcement.pattern }}" style="{{ bg.announcement.style }}">{{ features.announcement }}</div>
{% endif %}

{# Lưu ý: không đặt backdrop-filter / transform lên chính <header>, vì khi đó khung menu và ô tìm kiếm
   (position: fixed) bên trong bị giới hạn trong chiều cao header → menu điện thoại bị cắt, không lướt được. Nền mờ nằm ở lớp riêng bên dưới. #}
<header x-data="siteHeader" @scroll.window.passive="onScroll"
  :class="scrolled && 'shadow-[0_1px_0_var(--c-border)]'"
  class="sticky top-0 z-50">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 transition-colors duration-300"
    :class="scrolled ? 'bg-surface/90 backdrop-blur-md' : 'bg-bg'"></div>
  <div class="container-x flex h-[var(--header-h)] items-center gap-4">
    <button class="icon-btn -ml-2 lg:hidden" @click="menuOpen = true" aria-label="Mở menu">{{ icon('menu', 'w-6 h-6') }}</button>

    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="{{ s.site.name }} - Trang chủ">
      {% if s.site.logo %}
        <img src="{{ s.site.logo.sm }}" alt="{{ s.site.name }}" class="h-[68px] w-auto {{ 'logo-light-only' if s.site.logo_light }}" width="{{ s.site.logo.width }}" height="{{ s.site.logo.height }}">
        {% if s.site.logo_light %}<img src="{{ s.site.logo_light.sm }}" alt="" aria-hidden="true" class="logo-dark-only h-[68px] w-auto" width="{{ s.site.logo_light.width }}" height="{{ s.site.logo_light.height }}">{% endif %}
      {% else %}
        <span class="font-heading text-2xl font-semibold tracking-tight text-primary">{{ s.site.name }}</span>
      {% endif %}
    </a>

    <nav class="mx-auto hidden lg:block" aria-label="Menu chính">
      <ul class="flex items-center gap-1">
        {% for item in nav %}
        {% set active = (item.url == '/' and currentPath == '/') or (item.url != '/' and currentPath.startsWith(item.url)) %}
        <li class="{{ 'group/dd relative' if item.children.length }}">
          <a href="{{ item.url }}" class="relative inline-flex items-center gap-1 whitespace-nowrap px-2.5 py-2 text-[14px] tracking-wide transition xl:px-3 hover:text-primary {{ 'text-primary font-medium' if active else 'text-ink/80' }}">
            {{ item.label }}{% if item.children.length %}{{ icon('chevron-down', 'w-3.5 h-3.5 opacity-60 transition group-hover/dd:rotate-180') }}{% endif %}
            {% if active %}<span class="absolute inset-x-3 -bottom-0.5 h-px bg-accent"></span>{% endif %}
          </a>
          {% if item.children.length %}
          {# Menu sổ dọc: hiện khi rê chuột hoặc khi tab bàn phím vào (không cần JS) #}
          <div class="invisible absolute left-0 top-full z-50 min-w-56 pt-2 opacity-0 transition duration-200 group-hover/dd:visible group-hover/dd:opacity-100 group-focus-within/dd:visible group-focus-within/dd:opacity-100">
            <ul class="max-h-[70vh] overflow-y-auto rounded-lg border border-line bg-surface p-1.5 shadow-xl shadow-ink/10">
              {% for c in item.children %}<li><a href="{{ c.url }}" class="block rounded-md px-3 py-2 text-[13.5px] text-ink/85 transition hover:bg-primary/[.06] hover:text-primary">{{ c.label }}</a></li>{% endfor %}
              <li class="mt-1 border-t border-line pt-1"><a href="{{ item.url }}" class="block rounded-md px-3 py-2 text-[13px] font-medium text-accent hover:bg-primary/[.06]">Xem tất cả</a></li>
            </ul>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <button class="icon-btn" @click="searchOpen = true; $nextTick(() => document.getElementById('search-input')?.focus())" aria-label="Tìm kiếm">{{ icon('search') }}</button>
      {% if s.theme.dark_mode != 'off' %}
      <button class="icon-btn" @click="$store.theme.toggle()" :aria-label="$store.theme.dark ? 'Chuyển sang giao diện sáng' : 'Chuyển sang giao diện tối'" :title="$store.theme.dark ? 'Giao diện sáng' : 'Giao diện tối'">
        <span x-show="!$store.theme.dark">{{ icon('moon') }}</span><span x-cloak x-show="$store.theme.dark">{{ icon('sun') }}</span>
      </button>
      {% endif %}
      {% if features.checkout %}
      <a href="/gio-hang" class="icon-btn relative" aria-label="Giỏ hàng">
        {{ icon('bag') }}
        <span x-cloak x-show="$store.cart.count > 0" x-text="$store.cart.count"
          class="absolute -right-0.5 -top-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-accent px-1 text-[10px] font-semibold text-white"></span>
      </a>
      {% endif %}
      <a href="tel:{{ s.site.phone | phoneHref }}" class="btn btn-primary btn-sm ml-2 hidden xl:inline-flex">{{ icon('phone', 'w-4 h-4') }} {{ s.site.phone }}</a>
    </div>
  </div>

  {# Ô tìm kiếm #}
  <div x-cloak x-show="searchOpen" x-transition.opacity class="fixed inset-0 z-[70] bg-ink/40 backdrop-blur-sm" @click.self="searchOpen = false" @keydown.escape.window="searchOpen = false">
    <div x-show="searchOpen" x-transition:enter="transition duration-300" x-transition:enter-start="-translate-y-6 opacity-0" class="bg-surface shadow-xl">
      <div x-data="searchSuggest" @keydown.escape="close()">
      <form action="/san-pham" method="get" class="container-x flex items-center gap-3 py-5" role="search" @submit="close()">
        {{ icon('search', 'w-5 h-5 text-muted') }}
        <input id="search-input" type="search" name="q" x-model="q" @input="onInput()" @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)" @keydown.enter="enter($event)"
          autocomplete="off" role="combobox" aria-autocomplete="list" :aria-expanded="open" aria-controls="search-suggest-list"
          placeholder="Tìm vòng ngọc, loại ngọc, mã sản phẩm..." class="flex-1 bg-transparent py-2 text-lg outline-none" aria-label="Từ khóa tìm kiếm">
        <button type="submit" class="btn btn-primary btn-sm">Tìm</button>
        <button type="button" class="icon-btn" @click="searchOpen = false" aria-label="Đóng">{{ icon('close') }}</button>
      </form>
      {% if s.features.search_suggest %}
      <div id="search-suggest-list" class="container-x max-h-[60vh] overflow-y-auto pb-4" x-show="open" x-cloak role="listbox" aria-label="Gợi ý tìm kiếm">
        <div class="flex flex-wrap gap-2 pb-3" x-show="groups.length">
          <template x-for="(g, gi) in groups" :key="g.url">
            <a :href="g.url" class="chip" :class="active === gi && '!border-primary !bg-primary !text-on-primary'" role="option" :aria-selected="active === gi" x-text="g.name"></a>
          </template>
        </div>
        <ul class="divide-y divide-line">
          <template x-for="(it, ii) in items" :key="it.url">
            <li>
              <a :href="it.url" class="flex items-center gap-3 rounded-md px-2 py-2.5 hover:bg-bg" :class="active === groups.length + ii && 'bg-bg ring-1 ring-primary'" role="option" :aria-selected="active === groups.length + ii">
                <span class="h-14 w-14 shrink-0 overflow-hidden rounded-md bg-bg">
                  <img x-show="it.cover" :src="it.cover && it.cover.sm" alt="" width="56" height="56" loading="lazy" class="h-full w-full object-cover">
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium" x-text="it.name"></span>
                  <span class="block truncate text-xs text-muted" x-text="it.type" x-show="it.type"></span>
                </span>
                <span class="shrink-0 text-right text-sm">
                  <span class="block font-semibold text-primary" x-show="it.final_price != null" x-text="vnd(it.final_price)"></span>
                  <span class="block text-xs text-muted" x-show="it.sold_out">Đã bán</span>
                </span>
              </a>
            </li>
          </template>
        </ul>
        <p class="py-3 text-center text-sm text-muted" x-show="empty">Chưa có sản phẩm phù hợp. Thử từ khóa khác hoặc bấm “Tìm” để xem tất cả kết quả.</p>
        <a :href="'/san-pham?q=' + encodeURIComponent(q.trim())" class="mt-1 block text-center text-sm font-medium text-accent hover:underline" x-show="items.length">Xem tất cả kết quả cho “<span x-text="q.trim()"></span>”</a>
      </div>
      {% endif %}
      </div>
      {% if jadeTypes.length %}
      <div class="container-x flex flex-wrap items-center gap-2 pb-5 text-sm">
        <span class="text-muted">Gợi ý:</span>
        {% for t in jadeTypes %}<a href="/san-pham/{{ t.slug }}" class="chip">{{ t.name }}</a>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>

  {# Menu di động #}
  <div x-cloak x-show="menuOpen" class="fixed inset-0 z-[70] lg:hidden" @keydown.escape.window="menuOpen = false">
    <div x-show="menuOpen" x-transition.opacity class="absolute inset-0 bg-ink/40" @click="menuOpen = false"></div>
    <aside x-show="menuOpen" x-trap.noscroll="menuOpen"
      x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="-translate-x-full"
      x-transition:leave="transition duration-200 ease-in" x-transition:leave-end="-translate-x-full"
      class="absolute inset-y-0 left-0 flex w-[84%] max-w-sm flex-col bg-surface shadow-2xl">
      <div class="flex items-center justify-between border-b border-line px-5 py-4">
        <span class="font-heading text-xl text-primary">{{ s.site.name }}</span>
        <button class="icon-btn" @click="menuOpen = false" aria-label="Đóng menu">{{ icon('close') }}</button>
      </div>
      <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Menu di động">
        {% for item in nav %}
        {% set mActive = (item.url == '/' and currentPath == '/') or (item.url != '/' and currentPath.startsWith(item.url)) %}
        {% if item.children.length %}
        <div x-data="{ sub: {{ 'true' if mActive else 'false' }} }">
          <div class="flex items-center rounded-md hover:bg-ink/5">
            <a href="{{ item.url }}" class="flex-1 px-3 py-3 text-[15px] {{ 'text-primary font-medium' if mActive else '' }}" {{ 'aria-current=page' if mActive }}>{{ item.label }}</a>
            <button type="button" class="px-3 py-3 text-muted" @click="sub = !sub" :aria-expanded="sub" aria-label="Mở danh sách {{ item.label }}">{{ icon('chevron-down', 'w-4 h-4 transition') }}</button>
          </div>
          <ul x-cloak x-show="sub" x-collapse class="ml-3 border-l border-line pl-2">
            {% for c in item.children %}<li><a href="{{ c.url }}" class="block rounded-md px-3 py-2.5 text-sm text-ink/80 hover:bg-ink/5">{{ c.label }}</a></li>{% endfor %}
          </ul>
        </div>
        {% else %}
        <a href="{{ item.url }}" class="flex items-center justify-between rounded-md px-3 py-3 text-[15px] hover:bg-ink/5 {{ 'text-primary font-medium' if mActive else '' }}" {{ 'aria-current=page' if mActive }}>
          {{ item.label }} {{ icon('chevron-right', 'w-4 h-4 text-muted') }}
        </a>
        {% endif %}
        {% endfor %}
      </nav>
      <div class="space-y-2 border-t border-line p-5 text-sm">
        <a href="tel:{{ s.site.phone | phoneHref }}" class="btn btn-primary w-full">{{ icon('phone', 'w-4 h-4') }} {{ s.site.phone }}</a>
        {% if s.site.zalo %}<a href="https://zalo.me/{{ s.site.zalo | phoneHref }}" target="_blank" rel="noopener" class="btn btn-outline w-full">{{ icon('chat', 'w-4 h-4') }} Nhắn Zalo</a>{% endif %}
      </div>
    </aside>
  </div>
</header>
