{% extends "layout.njk" %}
{% from "partials/icons.njk" import icon %}
{% block title %}Khách hàng{% endblock %}
{% block heading %}<a href="{{ A }}/customers" class="mr-2 text-slate-400 hover:text-slate-600">Khách hàng /</a>Chi tiết{% endblock %}
{% block content %}
<div x-data="customerDetail({{ params.id | dump }})">
  <template x-if="c">
    <div class="grid gap-6 lg:grid-cols-[360px_1fr]">
      <form class="card card-body space-y-4 self-start" @submit.prevent="save()">
        <div><label class="label">Họ tên</label><input class="input" x-model="c.name"></div>
        <div><label class="label">Điện thoại</label><div class="flex gap-2"><input class="input bg-slate-50" :value="c.phone" disabled><a :href="'tel:' + c.phone" class="btn btn-secondary">{{ icon('phone', 'w-4 h-4') }}</a></div></div>
        <div><label class="label">Email</label><input class="input" x-model="c.email"></div>
        <div><label class="label">Địa chỉ</label><textarea class="input" rows="2" x-model="c.address"></textarea></div>
        <div><label class="label">Ni tay / số đo</label><input class="input" x-model="c.wrist_size"></div>
        <div><label class="label">Nhãn</label><input class="input" x-model="c.tags" placeholder="VIP, khách sỉ... cách nhau bằng dấu phẩy"></div>
        <div><label class="label">Ghi chú</label><textarea class="input" rows="4" x-model="c.note"></textarea></div>
        <div class="flex gap-2"><button class="btn btn-primary" :disabled="saving">Lưu</button>
          {% if currentUser.role == 'owner' %}<button type="button" class="btn btn-ghost ml-auto text-red-600" @click="remove()">Xóa khách</button>{% endif %}</div>
      </form>
      <div class="card overflow-hidden self-start">
        <div class="card-head"><h3 class="card-title">Lịch sử đơn & yêu cầu</h3></div>
        <table class="table">
          <thead><tr><th>Mã</th><th>Loại</th><th>Nội dung</th><th>Trạng thái</th><th>Thời gian</th></tr></thead>
          <tbody>
            <template x-for="i in c.inquiries" :key="i.id">
              <tr class="cursor-pointer" @click="location.href = '{{ A }}/inquiries/' + i.id">
                <td class="font-mono text-xs" x-text="i.code"></td><td x-text="i.type_label"></td>
                <td class="max-w-xs"><p class="line-clamp-1 text-slate-600" x-text="i.type === 'order' ? $fmt.vnd(i.total) + ' · ' + i.items.map(x => x.name).join(', ') : i.message"></p></td>
                <td><span class="badge" :class="Admin.STATUS_COLOR[i.status]" x-text="i.status_label"></span></td>
                <td class="text-slate-500" x-text="$fmt.date(i.created_at)"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>
  </template>
</div>
{% endblock %}
