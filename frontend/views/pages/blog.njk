{% extends "layouts/base.njk" %}
{% block content %}
<section class="border-b border-line bg-surface">
  <div class="container-x py-12 text-center md:py-16">
    <span class="eyebrow">Blog</span>
    <h1 class="mt-3 text-4xl font-medium md:text-5xl">{{ s.pages.blog_title }}</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">{{ s.pages.blog_intro }}</p>
  </div>
</section>
<section class="container-x py-14">
  {% if result.items.length %}
  <div class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
    {% for p in result.items %}{% include "partials/post-card.njk" %}{% endfor %}
  </div>
  {% if result.pages > 1 %}
  <nav class="mt-14 flex justify-center gap-1.5" aria-label="Phân trang">
    {% for n in range(1, result.pages + 1) %}
    <a href="/blog{{ '?trang=' + n if n > 1 }}" class="flex h-10 min-w-10 items-center justify-center rounded-full px-3 text-sm {{ 'bg-primary text-on-primary' if n == result.page else 'hover:bg-ink/5' }}">{{ n }}</a>
    {% endfor %}
  </nav>
  {% endif %}
  {% else %}
  <p class="py-20 text-center text-muted">Chưa có bài viết nào.</p>
  {% endif %}
</section>
{% endblock %}
