{# ================= FEEDBACK KHÁCH HÀNG ================= #}
{# Nội dung nhập ở Admin › Feedback & đánh giá; chữ và cách hiển thị ở Cài đặt › Feedback & đánh giá khách hàng #}
{% if feedbacks.items.length %}
{% set fb = s.feedback %}
<section class="section" aria-label="{{ fb.home_title }}">
  <div class="container-x">
    {% set fbItems = feedbacks.items %}
    {% set fbH = 'h2' %}
    {% set fbTitle = fb.home_title %}
    {% set fbSubtitle = fb.home_subtitle %}
    {% set fbImage = fb.home_image %}
    {% set fbPanel = fb.home_show_panel %}
    {% set fbCols = fb.home_cols %}
    {% set fbButton = { url: '/' + fb.page_slug, label: fb.home_button_label } if (fb.home_show_button and fb.page_enabled) else null %}
    {% include "partials/feedback-block.njk" %}
  </div>
</section>
{% include "partials/feedback-modal.njk" %}
{% endif %}
