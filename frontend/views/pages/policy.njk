{% extends "layouts/base.njk" %}
{% block content %}
<div class="container-x py-10 md:py-14">
  <nav class="text-xs text-muted" aria-label="Breadcrumb"><a href="/" class="hover:text-primary">Trang chủ</a><span class="mx-1.5">/</span><span>{{ policy.title }}</span></nav>
  <article class="mx-auto mt-6 max-w-3xl">
    <h1 class="text-balance text-3xl font-medium leading-tight md:text-5xl">{{ policy.title }}</h1>
    <div class="prose-jade mt-8">{{ policy.content | headings(1) | imgdims | safe }}</div>
  </article>
  {% if others.length %}
  <nav class="mx-auto mt-14 max-w-3xl border-t border-line pt-6" aria-label="Các chính sách khác">
    <p class="eyebrow">Các chính sách khác</p>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">{% for o in others %}<li><a href="/chinh-sach/{{ o.slug }}" class="inline-block py-1.5 text-primary underline underline-offset-4">{{ o.title }}</a></li>{% endfor %}</ul>
  </nav>
  {% endif %}
</div>
{% endblock %}
