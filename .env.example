# ==========================================================
#  CẤU HÌNH MÔI TRƯỜNG - copy file này thành ".env" rồi sửa
#  KHÔNG đưa file .env lên GitHub hay gửi cho người khác
# ==========================================================

# development (máy cá nhân) hoặc production (trên VPS)
NODE_ENV=development

# Cổng chạy ứng dụng (Nginx sẽ chuyển tiếp vào cổng này)
PORT=3000

# Địa chỉ website, KHÔNG có dấu / ở cuối. Dùng cho SEO, sitemap, link trong email
BASE_URL=http://localhost:3000

# Đường dẫn vào trang quản trị. Nên đổi thành chuỗi khó đoán, ví dụ /quan-tri-ln2026
ADMIN_PATH=/admin

# Hai khóa bí mật, mỗi khóa là chuỗi ngẫu nhiên dài 64 ký tự.
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET: ký cookie đăng nhập
# APP_SECRET: mã hóa mật khẩu email SMTP và mã 2FA trong database.
#   ĐỔI APP_SECRET SAU KHI ĐÃ CHẠY sẽ làm mất mật khẩu SMTP và 2FA đã lưu (phải nhập lại).
SESSION_SECRET=
APP_SECRET=

# Thời gian giữ đăng nhập admin (giờ)
SESSION_HOURS=8

# Dung lượng tối đa mỗi ảnh upload (MB)
UPLOAD_MAX_MB=10
