{% extends "layouts/base.njk" %}
{% block content %}
<div class="container-x py-10 md:py-14">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
    <article class="min-w-0">
      <header>
        <nav class="text-xs text-muted" aria-label="Breadcrumb"><a href="/" class="hover:text-primary">Trang chủ</a><span class="mx-1.5">/</span><a href="/blog" class="hover:text-primary">Blog</a>{% if category %}<span class="mx-1.5">/</span><a href="/blog/{{ category.slug }}" class="hover:text-primary">{{ category.name }}</a>{% endif %}</nav>
        {% if category %}<a href="/blog/{{ category.slug }}" class="eyebrow mt-5 inline-block hover:underline">{{ category.name }}</a>{% endif %}
        <h1 class="mt-4 text-balance text-3xl font-medium leading-tight md:text-5xl">{{ post.title }}</h1>
        <p class="mt-4 text-sm text-muted">{{ post.published_at | date }}{% if post.writer %} · {{ post.writer.name }}{% endif %} · {{ post.reading_minutes }} phút đọc</p>
      </header>
      {% if post.cover %}
      <img src="{{ post.cover.lg }}" srcset="{{ post.cover | srcset }}" sizes="(min-width:1024px) 760px, 100vw" alt="{{ post.cover.alt or post.title }}" width="{{ post.cover.width }}" height="{{ post.cover.height }}" decoding="async" class="mt-8 aspect-[16/9] w-full rounded-lg border border-line object-cover" fetchpriority="high">
      {% endif %}
      {% if toc.length %}
      {# Điện thoại / máy tính bảng: mục lục gập lại phía trên bài; máy tính để cột phải #}
      <details class="card mt-8 p-4 lg:hidden">
        <summary class="cursor-pointer font-heading text-lg font-medium">{{ s.pages.blog_toc_title }}</summary>
        <div class="mt-3">{% include "partials/blog-toc.njk" %}</div>
      </details>
      {% endif %}
      <div class="mt-8 max-w-3xl">
        {% if post.excerpt %}<p class="mb-8 font-heading text-xl italic leading-relaxed text-ink/80">{{ post.excerpt }}</p>{% endif %}
        <div class="prose-jade">{{ post.content | headings(1) | imgdims | safe }}</div>
      </div>
      {% if post.writer %}
      {# Khung giới thiệu tác giả (không có trang tác giả riêng) #}
      <aside class="card mt-12 flex max-w-3xl gap-4 p-5 sm:gap-5 sm:p-6" aria-label="{{ s.pages.blog_author_label }}">
        {% if post.writer.avatar %}<img src="{{ post.writer.avatar.sm }}" alt="{{ post.writer.name }}" width="{{ post.writer.avatar.width }}" height="{{ post.writer.avatar.height }}" loading="lazy" decoding="async" class="h-16 w-16 shrink-0 rounded-full object-cover sm:h-20 sm:w-20">{% endif %}
        <div class="min-w-0">
          <p class="eyebrow">{{ s.pages.blog_author_label }}</p>
          <p class="mt-1 font-heading text-xl font-medium">{{ post.writer.name }}{% if post.writer.job_title %}<span class="ml-2 text-sm font-normal text-muted">{{ post.writer.job_title }}</span>{% endif %}</p>
          {% if post.writer.bio %}<p class="mt-2 text-[15px] leading-relaxed text-muted">{{ post.writer.bio }}</p>{% endif %}
          {% if post.writer.links.length %}<p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">{% for l in post.writer.links %}<a href="{{ l }}" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4">{{ l | replace('https://', '') | replace('http://', '') | replace('www.', '') | truncate(32, true, '…') }}<span class="sr-only"> (mở trong tab mới)</span></a>{% endfor %}</p>{% endif %}
        </div>
      </aside>
      {% endif %}
    </article>
    <div class="lg:sticky lg:top-[calc(var(--header-h)+1rem)] lg:self-start">
      {% include "partials/blog-sidebar.njk" %}
    </div>
  </div>
</div>
{% endblock %}
