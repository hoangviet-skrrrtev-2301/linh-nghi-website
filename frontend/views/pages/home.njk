{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/product-card.njk" import productCard %}

{% block head %}{% set hero = s.home.hero_slides[0] %}{% if hero and hero.image %}<link rel="preload" as="image" href="{{ hero.image.lg }}" imagesrcset="{{ hero.image | srcset }}" imagesizes="100vw" fetchpriority="high">{% endif %}<link rel="stylesheet" href="/vendor/swiper/swiper-bundle.min.css"><link rel="stylesheet" href="/vendor/photoswipe/photoswipe.css">{% endblock %}

{% block content %}
{% for sec in sections %}
{% if sec.hasBg %}<div class="home-block has-bg {{ sec.pattern }}" style="{{ sec.style }}">{% endif %}
{% include "partials/home/" + sec.key + ".njk" %}
{% if sec.hasBg %}</div>{% endif %}
{% endfor %}
{% endblock %}

{% block scripts %}<script defer src="/vendor/swiper/swiper-bundle.min.js"></script>{% endblock %}
