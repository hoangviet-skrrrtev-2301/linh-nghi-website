<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Đăng nhập quản trị · {{ shop.name }}</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/admin-assets/css/admin.css?v={{ assetVersion }}">
</head>
<body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-brand-900 via-slate-900 to-slate-950 p-4">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-600/30">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12l4 6-10 12L2 9l4-6Z"/><path d="M2 9h20"/></svg>
      </div>
      <h1 class="mt-4 text-xl font-semibold !text-white">{{ shop.name }}</h1>
      <p class="text-sm text-slate-400">Trang quản trị</p>
    </div>

    <div class="card p-7">
      {% if error %}
      <div class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">{{ error }}</div>
      {% endif %}

      {% if step == 'totp' %}
      <form method="post" action="{{ A }}/login/2fa" class="space-y-5">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="next" value="{{ next }}">
        <div>
          <h2 class="text-lg font-semibold">Xác thực 2 bước</h2>
          <p class="mt-1 text-sm text-slate-500">Mở ứng dụng Google Authenticator và nhập mã 6 số.</p>
        </div>
        <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus
          class="input text-center text-2xl tracking-[0.5em]" placeholder="000000">
        <button class="btn btn-primary w-full py-2.5">Xác nhận</button>
        <a href="{{ A }}/login" class="block text-center text-sm text-slate-500 hover:text-slate-700">Quay lại</a>
      </form>
      {% else %}
      <form method="post" action="{{ A }}/login" class="space-y-5">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="next" value="{{ next }}">
        <div>
          <label class="label" for="email">Email</label>
          <input id="email" name="email" type="email" value="{{ email }}" autocomplete="username" required autofocus class="input py-2.5">
        </div>
        <div>
          <label class="label" for="password">Mật khẩu</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required class="input py-2.5">
        </div>
        <button class="btn btn-primary w-full py-2.5">Đăng nhập</button>
      </form>
      {% endif %}
    </div>
    <p class="mt-6 text-center text-xs text-slate-500">Quên mật khẩu? Liên hệ Chủ shop hoặc xem hướng dẫn trong tài liệu bàn giao.</p>
  </div>
</body>
</html>
