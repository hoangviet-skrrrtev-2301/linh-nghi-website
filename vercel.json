{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{backend,frontend,admin,database/migrations,database/seeds,database/content-pack,node_modules/alpinejs,node_modules/@alpinejs,node_modules/swiper,node_modules/photoswipe,node_modules/quill}/**"
    }
  }
}
