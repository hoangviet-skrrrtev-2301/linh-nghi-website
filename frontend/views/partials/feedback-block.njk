{% from "partials/icons.njk" import icon %}
{% from "partials/stars.njk" import stars %}
{# Khối feedback dùng chung cho trang chủ và trang Feedback (khung giới thiệu bên trái + lưới thẻ feedback bên phải).
   Biến cần đặt trước khi include: fbItems, fbH ('h1' | 'h2'), fbTitle, fbSubtitle, fbImage, fbPanel (hiện khung trái), fbCols (1-3), fbButton ({url, label} hoặc rỗng).
   Bấm vào thẻ mở cửa sổ chi tiết (partials/feedback-modal.njk) nếu bật "popup" trong cài đặt. #}
{% set fbPopup = s.feedback.popup_enabled %}
{% set fbStars = s.feedback.show_stars %}
{% set colClass = { '1': '', '2': 'sm:grid-cols-2', '3': 'sm:grid-cols-2 xl:grid-cols-3' }[fbCols | string] %}
{% set words = (fbTitle or '').split(' ') %}
{% set lastWord = words[words.length - 1] %}
{% set leadWords = words.slice(0, words.length - 1).join(' ') %}

{% if not fbPanel %}
<div class="section-head reveal">
  <{{ fbH }} class="section-title !mt-0">{{ fbTitle }}</{{ fbH }}>
  {% if fbSubtitle %}<p class="mt-3 text-muted">{{ fbSubtitle }}</p>{% endif %}
</div>
{% endif %}

<div class="{{ 'grid gap-4 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]' if fbPanel }}">
  {% if fbPanel %}
  <div class="fb-panel reveal flex min-h-[20rem] flex-col rounded-[28px] p-7 lg:p-8">
    <{{ fbH }} class="font-heading text-3xl font-semibold leading-tight md:text-4xl">{% if leadWords %}{{ leadWords }} {% endif %}<span class="text-primary">{{ lastWord }}</span></{{ fbH }}>
    {% if fbSubtitle %}<p class="mt-3 max-w-xs text-sm font-medium leading-relaxed text-ink/70">{{ fbSubtitle }}</p>{% endif %}
    {% if fbImage %}
    <div class="mt-auto flex justify-center pt-8">
      <img src="{{ fbImage.md }}" srcset="{{ fbImage | srcset }}" sizes="(min-width:1024px) 22rem, 90vw" alt="{{ fbImage.alt or '' }}" width="{{ fbImage.width }}" height="{{ fbImage.height }}"
        class="no-dim max-h-72 w-auto max-w-full object-contain drop-shadow-xl" loading="lazy" decoding="async">
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="grid content-start gap-4 {{ colClass }}">
    {% for f in fbItems %}
    <article class="fb-card reveal relative flex flex-col justify-between gap-6 rounded-[28px] border border-line bg-surface p-7 transition {{ 'hover:border-primary/40 hover:shadow-md' if fbPopup }}">
      {% if fbPopup %}<button type="button" class="absolute inset-0 rounded-[28px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" @click="$store.fb.show({{ loop.index0 }})" aria-label="Xem chi tiết feedback của {{ f.name }}"></button>{% endif %}
      {% if f.content %}
      <p class="line-clamp-5 text-[15.5px] leading-relaxed text-muted">{{ f.content }}</p>
      {% elif f.images.length %}
      <div class="flex gap-2">
        {% for im in f.images.slice(0, 3) %}<img src="{{ im.sm }}" alt="" width="{{ im.width }}" height="{{ im.height }}" class="h-24 w-20 rounded-xl border border-line object-cover" loading="lazy" decoding="async">{% endfor %}
      </div>
      {% endif %}
      <div class="flex items-center gap-3">
        <div class="flex min-w-0 flex-1 items-center gap-3">
          {% if f.avatar %}
          <img src="{{ f.avatar.sm }}" alt="" width="44" height="44" class="h-11 w-11 shrink-0 rounded-full object-cover" loading="lazy" decoding="async">
          {% else %}
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 font-heading text-lg font-semibold text-primary" aria-hidden="true">{{ f.name | first | upper }}</span>
          {% endif %}
          <div class="min-w-0">
            <p class="break-words text-[15px] font-semibold leading-snug text-ink">{{ f.name }}{% if f.role %}<span class="font-semibold"> - {{ f.role }}</span>{% endif %}</p>
            {% if (fbStars and f.rating) or (f.images.length and f.content) %}
            <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-0.5">
              {% if fbStars and f.rating %}{{ stars(f.rating, 'h-[18px] w-[18px]') }}{% endif %}
              {% if f.images.length and f.content %}<span class="inline-flex items-center gap-1 text-xs text-muted">{{ icon('image', 'w-4 h-4') }} {{ f.images.length }} ảnh</span>{% endif %}
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</div>

{% if fbButton %}
<div class="mt-8 text-center"><a href="{{ fbButton.url }}" class="btn btn-outline">{{ fbButton.label }} {{ icon('arrow-right', 'w-4 h-4') }}</a></div>
{% endif %}

{% if fbPopup %}<script type="application/json" id="fb-data">{{ fbItems | jsonScript }}</script>{% endif %}
