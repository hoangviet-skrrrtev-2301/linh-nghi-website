{% extends "layout.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/fields.njk" import schemaField %}
{% block title %}Cài đặt · {{ group.label }}{% endblock %}
{% block heading %}Cài đặt website{% endblock %}
{% block content %}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">
  <nav class="flex gap-1 overflow-x-auto lg:flex-col">
    {% for g in groups %}<a href="{{ A }}/settings/{{ g.key }}" class="tab {{ 'active' if g.key == group.key }}">{{ g.label }}</a>{% endfor %}
    {% if currentUser.role == 'owner' %}
    <a href="{{ A }}/api/backup" class="tab mt-4 border-t border-slate-200 pt-3 text-brand-700">{{ icon('download', 'inline w-4 h-4 mr-1') }} Tải bản sao lưu</a>
    {% endif %}
  </nav>

  {% set secKeys = [] %}{% for sec in group.sections %}{% set _ = secKeys.push(sec.key) %}{% endfor %}
  <div x-data="settingsPage({{ group.key | dump }}, {{ secKeys | attrjson }})">
    <template x-if="values">
      <form @submit.prevent="save()" class="space-y-6">
        <div class="card">
          <div class="card-head">
            <div><h2 class="card-title">{{ group.label }}</h2>{% if group.description %}<p class="mt-0.5 text-xs text-slate-500">{{ group.description }}</p>{% endif %}</div>
            <button class="btn btn-primary" :disabled="saving">{{ icon('check', 'w-4 h-4') }} Lưu</button>
          </div>
          {% set secs = group.sections or [{ key: '', label: '' }] %}
          {% if group.sections %}
          {# Nhóm có nhiều phần: mỗi phần thu gọn / mở ra được, trạng thái nhớ lại cho lần sau #}
          <div class="flex flex-wrap items-center gap-2 border-b border-slate-100 bg-slate-50/60 px-5 py-2.5 text-xs text-slate-500">
            <span>Bấm vào tên từng phần để mở hoặc thu gọn.</span>
            <button type="button" class="btn btn-ghost btn-sm ml-auto" @click="toggleAll(true)">Mở tất cả</button>
            <button type="button" class="btn btn-ghost btn-sm" @click="toggleAll(false)">Thu gọn tất cả</button>
          </div>
          {% endif %}
          {% for sec in secs %}
          {% if group.sections %}
          <button type="button" class="flex w-full items-center gap-3 border-b border-slate-100 px-5 py-3.5 text-left transition hover:bg-slate-50" @click="toggle('{{ sec.key }}')" :aria-expanded="isOpen('{{ sec.key }}')">
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-semibold text-slate-900">{{ sec.label }}</span>
              {% if sec.hint %}<span class="block truncate text-xs text-slate-500">{{ sec.hint }}</span>{% endif %}
            </span>
            {% if sec.toggle %}<span class="badge" :class="values.{{ sec.toggle }} ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500'" x-text="values.{{ sec.toggle }} ? 'Đang hiện' : 'Đang ẩn'"></span>{% endif %}
            <span class="text-slate-400 transition-transform duration-200" :class="isOpen('{{ sec.key }}') && 'rotate-180'">{{ icon('chevron-down', 'w-4 h-4') }}</span>
          </button>
          {% endif %}
          <div {% if group.sections %}x-cloak x-show="isOpen('{{ sec.key }}')" x-collapse{% endif %}>
          <div class="card-body grid gap-5 md:grid-cols-2 {{ 'border-b border-slate-100 bg-slate-50/40' if group.sections }}">
            {% for f in group.fields %}
              {% if (f.section or secs[0].key) == sec.key %}
              {% if f.type == 'list' %}
              {# ---- Danh sách lặp (slide, khối thông tin, bảng size...) ---- #}
              <div class="md:col-span-2">
                <div class="mb-2 flex items-center justify-between">
                  <label class="label !mb-0">{{ f.label }}</label>
                  {% if f.collapsible %}<span class="ml-auto mr-2 flex gap-1"><button type="button" class="btn btn-ghost btn-sm" @click="toggleItems('{{ f.name }}', true)">Mở tất cả</button><button type="button" class="btn btn-ghost btn-sm" @click="toggleItems('{{ f.name }}', false)">Thu gọn</button></span>{% endif %}
                  {% if not f.fixed %}<button type="button" class="btn btn-secondary btn-sm" @click="addItem('{{ f.name }}', {{ f.fields | blankItem | attrjson }})">{{ icon('plus', 'w-3.5 h-3.5') }} Thêm</button>{% endif %}
                </div>
                <div class="space-y-3">
                  <template x-for="(item, i) in values.{{ f.name }}" :key="i">
                    <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4" :class="{% if f.fixed %}item.enabled === false && 'opacity-60'{% else %}''{% endif %}">
                      <div class="flex items-center gap-2 text-xs text-slate-500 {{ '' if f.collapsible else 'mb-3' }}">
                        {% if f.collapsible %}
                        {# Danh sách nhiều mục: bấm tên mục để mở / thu gọn nội dung #}
                        <button type="button" class="flex min-w-0 flex-1 items-center gap-2 text-left" @click="toggleItem('{{ f.name }}', i)" :aria-expanded="itemOpen('{{ f.name }}', i)">
                          <span class="font-semibold" x-text="'#' + (i + 1)"></span>
                          <span class="truncate text-sm font-semibold text-slate-800" x-text="item.{{ f.itemTitle or 'label' }} || 'Chưa đặt tên'"></span>
                          {% if f.fixed %}<span class="badge shrink-0" :class="item.enabled === false ? 'bg-slate-100 text-slate-500' : 'bg-emerald-50 text-emerald-700'" x-text="item.enabled === false ? 'Đang ẩn' : 'Đang hiện'"></span>
                          <span class="badge shrink-0 bg-violet-50 text-violet-700" x-show="item.bg_mode && item.bg_mode !== 'none'">Có nền riêng</span>{% endif %}
                          <span class="ml-auto shrink-0 text-slate-400 transition-transform duration-200" :class="itemOpen('{{ f.name }}', i) && 'rotate-180'">{{ icon('chevron-down', 'w-4 h-4') }}</span>
                        </button>
                        {% else %}
                        <span class="font-semibold" x-text="'#' + (i + 1)"></span>
                        {% if f.fixed %}<span class="text-sm font-semibold text-slate-800" x-text="item.label"></span>{% endif %}
                        <span class="ml-auto"></span>
                        {% endif %}
                        <button type="button" class="btn btn-ghost btn-sm" @click="move('{{ f.name }}', i, -1)" :disabled="i === 0">↑</button>
                        <button type="button" class="btn btn-ghost btn-sm" @click="move('{{ f.name }}', i, 1)" :disabled="i === values.{{ f.name }}.length - 1">↓</button>
                        {% if not f.fixed %}<button type="button" class="btn btn-ghost btn-sm text-red-600" @click="removeItem('{{ f.name }}', i)">{{ icon('trash', 'w-3.5 h-3.5') }}</button>{% endif %}
                      </div>
                      <div {% if f.collapsible %}x-cloak x-show="itemOpen('{{ f.name }}', i)" x-collapse{% endif %}>
                      <div class="grid gap-4 {{ 'mt-3' if f.collapsible }} {{ 'md:grid-cols-2' if f.fields.length > 1 }} {{ 'lg:grid-cols-4' if f.fields.length == 4 and (f.fields | allText) }}">
                        {% for sub in f.fields %}{% if not sub.hidden %}
                        <div class="{{ 'md:col-span-2 lg:col-span-full' if sub.type in ['richtext', 'textarea'] }}"
                          {% if sub.showIf %}x-show="{{ sub.showIf }}"{% elif sub.noBgFor %}x-show="!{{ sub.noBgFor | attrjson }}.includes(item.key)"{% endif %}>
                          {{ schemaField(sub, 'item.' + sub.name, 'media[item.' + sub.name + ']') }}
                        </div>
                        {% endif %}{% endfor %}
                      </div>
                      </div>
                    </div>
                  </template>
                  <p x-show="!values.{{ f.name }}.length" class="rounded-xl border border-dashed border-slate-300 py-6 text-center text-sm text-slate-500">Chưa có mục nào</p>
                </div>
              </div>
              {% else %}
              <div class="{{ 'md:col-span-2' if f.type in ['richtext', 'textarea', 'toggle'] }}">
                {{ schemaField(f, 'values.' + f.name, 'media[values.' + f.name + ']') }}
              </div>
              {% endif %}
              {% endif %}
            {% endfor %}
          </div>
          </div>
          {% endfor %}
          <div class="flex flex-wrap items-center gap-3 border-t border-slate-100 px-5 py-4">
            <button class="btn btn-primary" :disabled="saving">{{ icon('check', 'w-4 h-4') }} Lưu thay đổi</button>
            {% if group.key == 'mail' %}
            <button type="button" class="btn btn-secondary" :disabled="testing" @click="testMail()">{{ icon('mail', 'w-4 h-4') }} <span x-text="testing ? 'Đang gửi...' : 'Lưu & gửi email thử'"></span></button>
            {% endif %}
            <a href="/" target="_blank" class="btn btn-ghost ml-auto">{{ icon('eye', 'w-4 h-4') }} Xem website</a>
          </div>
        </div>

        {% if group.key == 'mail' %}
        <div class="card card-body text-sm leading-relaxed text-slate-600">
          <h3 class="card-title mb-2">Hướng dẫn tạo Mật khẩu ứng dụng Gmail</h3>
          <ol class="list-decimal space-y-1 pl-5">
            <li>Đăng nhập Gmail của shop, vào <b>myaccount.google.com › Bảo mật</b>.</li>
            <li>Bật <b>Xác minh 2 bước</b> (bắt buộc).</li>
            <li>Tìm mục <b>Mật khẩu ứng dụng</b> (App passwords), đặt tên “Website” và bấm Tạo.</li>
            <li>Copy mã 16 ký tự, dán vào ô <b>Mật khẩu ứng dụng</b> ở trên (không cần dấu cách).</li>
            <li>Máy chủ: <code>smtp.gmail.com</code>, cổng <code>465</code>, bật SSL. Bấm “Lưu & gửi email thử”.</li>
          </ol>
        </div>
        {% endif %}
      </form>
    </template>
  </div>
</div>
{% endblock %}
