{% extends "layout.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/fields.njk" import imageField, richText %}
{% block title %}{{ 'Sửa bài viết' if params.id else 'Viết bài mới' }}{% endblock %}
{% block heading %}<a href="{{ A }}/posts" class="mr-2 hidden text-slate-400 hover:text-slate-600 sm:inline">Blog /</a>{{ 'Sửa bài viết' if params.id else 'Viết bài mới' }}{% endblock %}
{% block content %}
<div x-data="postEdit({{ (params.id or '') | dump }})">
  <template x-if="form">
    <form @submit.prevent="save()" class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="space-y-6">
        <div class="card card-body space-y-5">
          <input class="w-full border-0 bg-transparent text-2xl font-semibold outline-none placeholder:text-slate-300" placeholder="Tiêu đề bài viết" x-model="form.title" @input="onTitle()">
          <div class="flex items-center rounded-lg border border-slate-300 bg-slate-50 text-sm"><span class="whitespace-nowrap pl-3 text-slate-400">/blog/</span><input class="w-full bg-transparent px-1 py-2 outline-none" x-model="form.slug" @input="slugTouched = true"></div>
          <div><label class="label">Tóm tắt</label><textarea class="input" rows="2" x-model="form.excerpt" placeholder="Hiển thị ở danh sách bài viết"></textarea></div>
          <div><label class="label">Nội dung</label>{{ richText('form.content') }}</div>
        </div>
        <div class="card card-body space-y-4">
          <h3 class="card-title">SEO</h3>
          <div><label class="label">Tiêu đề SEO</label><input class="input" x-model="form.seo_title" :placeholder="form.title"></div>
          <div><label class="label">Mô tả SEO</label><textarea class="input" rows="2" x-model="form.seo_description" :placeholder="form.excerpt"></textarea></div>
        </div>
      </div>
      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <div class="card card-body space-y-3">
          <div class="flex items-center justify-between text-sm"><span class="text-slate-500">Trạng thái</span><span class="badge" :class="form.status === 'published' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500'" x-text="form.status === 'published' ? 'Đã đăng' : 'Nháp'"></span></div>
          <div><label class="label">Ngày đăng</label><input type="datetime-local" class="input" x-model="form.published_at"><p class="help">Để trống = đăng ngay. Chọn ngày tương lai để hẹn giờ đăng.</p></div>
          <button type="button" class="btn btn-primary w-full" :disabled="saving" @click="save(true)" x-text="form.status === 'published' ? 'Lưu thay đổi' : 'Đăng bài'"></button>
          <button type="button" class="btn btn-secondary w-full" :disabled="saving" @click="save(false)" x-text="form.status === 'published' ? 'Chuyển về nháp' : 'Lưu nháp'"></button>
          <a x-show="id && form.status === 'published'" :href="'/blog/' + form.slug" target="_blank" class="btn btn-ghost w-full">{{ icon('eye', 'w-4 h-4') }} Xem bài</a>
        </div>
        <div class="card card-body space-y-2">
          <label class="label">Chuyên mục</label>
          <select class="input" x-model="form.category_id">
            <option value="">Chưa phân loại</option>
            <template x-for="c in categories" :key="c.id"><option :value="c.id" x-text="c.name" :selected="String(c.id) === String(form.category_id)"></option></template>
          </select>
          <div class="flex gap-1.5"><input class="input" x-model="newCat" placeholder="Hoặc tạo chuyên mục mới..." maxlength="80" @keydown.enter.prevent="addCategory()"><button type="button" class="btn btn-secondary" :disabled="addingCat || !newCat.trim()" @click="addCategory()">Thêm</button></div>
        </div>
        <div class="card card-body"><label class="label">Ảnh bìa</label>{{ imageField('form.cover_media_id', 'form.cover') }}</div>
      </aside>
    </form>
  </template>
</div>
{% endblock %}
