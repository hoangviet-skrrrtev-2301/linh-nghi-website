{% from "partials/icons.njk" import icon %}
{# Cột phải của blog: mục lục (chỉ ở bài viết), gợi ý bài viết, banner dọc. Dùng biến toc, sidebarPosts, post #}
<div class="space-y-6 lg:max-h-[calc(100vh-var(--header-h)-2rem)] lg:overflow-y-auto lg:pr-1">
  {% if toc and toc.length %}
  <section class="card hidden p-5 lg:block" aria-label="{{ s.pages.blog_toc_title }}">
    <h2 class="mb-3 font-heading text-xl font-medium">{{ s.pages.blog_toc_title }}</h2>
    {% include "partials/blog-toc.njk" %}
  </section>
  {% endif %}

  {% if blogCategories and blogCategories.length %}
  <section class="card p-5" aria-label="{{ s.pages.blog_categories_title }}">
    <h2 class="mb-3 font-heading text-xl font-medium">{{ s.pages.blog_categories_title }}</h2>
    <ul class="space-y-1 text-sm">
      {% for c in blogCategories %}
      <li><a href="/blog/{{ c.slug }}" class="flex items-center justify-between rounded-md px-2 py-1.5 transition hover:bg-primary/[.06] hover:text-primary {{ 'font-medium text-primary' if (category and category.id == c.id) }}">{{ c.name }}<span class="text-xs text-muted">{{ c.post_count }}</span></a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if sidebarPosts and sidebarPosts.length %}
  <section class="card p-5" aria-label="{{ s.pages.blog_related_title }}">
    <h2 class="mb-4 font-heading text-xl font-medium">{{ s.pages.blog_related_title }}</h2>
    <ul class="space-y-4">
      {% for p in sidebarPosts %}
      <li>
        <a href="{{ p.url }}" class="group flex gap-3">
          <span class="block h-16 w-20 shrink-0 overflow-hidden rounded-md bg-ink/5">
            {% if p.cover %}<img src="{{ p.cover.sm }}" alt="" width="{{ p.cover.width }}" height="{{ p.cover.height }}" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">{% endif %}
          </span>
          <span class="min-w-0">
            <span class="line-clamp-2 text-sm font-medium leading-snug transition group-hover:text-primary">{{ p.title }}</span>
            <span class="mt-1 block text-xs text-muted">{{ p.published_at | date }}</span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if s.pages.blog_banner_show and s.pages.blog_banner %}
  <aside aria-label="Banner">
    {% if s.pages.blog_banner_url %}<a href="{{ s.pages.blog_banner_url }}" target="_blank" rel="noopener sponsored" class="block">{% endif %}
    <img src="{{ s.pages.blog_banner.md }}" alt="{{ s.pages.blog_banner_alt }}" width="{{ s.pages.blog_banner.width }}" height="{{ s.pages.blog_banner.height }}" loading="lazy" class="w-full rounded-lg border border-line object-cover">
    {% if s.pages.blog_banner_url %}</a>{% endif %}
  </aside>
  {% endif %}
</div>
