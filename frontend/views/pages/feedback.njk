{% extends "layouts/base.njk" %}
{% from "partials/icons.njk" import icon %}
{% from "partials/stars.njk" import stars %}

{% block content %}
{% set fb = s.feedback %}
{% set hasReviews = fb.reviews_enabled and reviews.total > 0 %}
<section class="section" x-data="{ tab: 'feedback' }">
  <div class="container-x">
    {% if hasReviews %}
    <div class="mb-8 flex flex-wrap items-center justify-center gap-2" role="tablist">
      <button type="button" role="tab" id="tab-fb" aria-controls="panel-fb" :aria-selected="tab === 'feedback'" class="chip" :class="tab === 'feedback' && '!border-primary !bg-primary !text-on-primary'" @click="tab = 'feedback'">{{ fb.page_tab_feedback }}</button>
      <button type="button" role="tab" id="tab-rv" aria-controls="panel-rv" :aria-selected="tab === 'reviews'" class="chip" :class="tab === 'reviews' && '!border-primary !bg-primary !text-on-primary'" @click="tab = 'reviews'">{{ fb.page_tab_reviews }} <span class="text-[11px] opacity-70">{{ reviews.total }}</span></button>
    </div>
    {% endif %}

    <div id="panel-fb" role="tabpanel" aria-labelledby="tab-fb" x-show="tab === 'feedback'">
      {% if result.items.length %}
      {% set fbItems = result.items %}
      {% set fbH = 'h1' %}
      {% set fbTitle = fb.page_title %}
      {% set fbSubtitle = fb.page_intro %}
      {% set fbImage = fb.page_image or fb.home_image %}
      {% set fbPanel = true %}
      {% set fbCols = feedbackCols %}
      {% set fbButton = null %}
      {% include "partials/feedback-block.njk" %}
      {% include "partials/pagination.njk" %}
      {% else %}
      <div class="section-head"><h1 class="section-title !mt-0">{{ fb.page_title }}</h1>{% if fb.page_intro %}<p class="mt-3 text-muted">{{ fb.page_intro }}</p>{% endif %}</div>
      <p class="py-10 text-center text-muted">{{ fb.page_empty }}</p>
      {% endif %}
    </div>

    {% if hasReviews %}
    <div id="panel-rv" role="tabpanel" aria-labelledby="tab-rv" x-show="tab === 'reviews'" x-cloak
      x-data="reviewList({{ { loaded: reviews.next, total: reviews.total, limit: reviews.limit, product: '' } | attrjson }})">
      <h2 class="mb-6 text-center font-heading text-3xl font-medium">{{ fb.page_tab_reviews }}</h2>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {% for r in reviews.items %}
        <article class="rounded-[28px] border border-line bg-surface p-6">
          <div class="flex items-center justify-between gap-3">{{ stars(r.rating, 'h-[18px] w-[18px]') }}<span class="text-xs text-muted">{{ r.date_label }}</span></div>
          {% if r.content %}<p class="mt-3 text-[15px] leading-relaxed text-ink/85">{{ r.content }}</p>{% endif %}
          <p class="mt-4 text-sm font-semibold">{{ r.name }} {% if r.verified %}<span class="ml-1 rounded-full bg-primary/10 px-2 py-0.5 align-middle text-[11px] font-medium text-primary">{{ fb.reviews_verified_label }}</span>{% endif %}</p>
          <a href="{{ r.product.url }}" class="mt-3 flex items-center gap-3 rounded-xl bg-ink/[.03] p-2.5 text-sm transition hover:bg-ink/[.06]">
            {% if r.product.cover %}<img src="{{ r.product.cover.sm }}" alt="" width="{{ r.product.cover.width }}" height="{{ r.product.cover.height }}" class="h-10 w-10 shrink-0 rounded-md object-cover" loading="lazy" decoding="async">{% endif %}
            <span class="min-w-0 truncate">{{ r.product.name }}</span>
          </a>
        </article>
        {% endfor %}
        <template x-for="r in extra" :key="r.id">
          <article class="rounded-[28px] border border-line bg-surface p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-0.5 text-accent" role="img" :aria-label="r.rating + ' trên 5 sao'">
                <template x-for="n in 5" :key="n"><svg class="h-[18px] w-[18px]" :class="n > r.rating && 'opacity-25'" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96L12 2.5z"/></svg></template>
              </span>
              <span class="text-xs text-muted" x-text="r.date_label"></span>
            </div>
            <p class="mt-3 text-[15px] leading-relaxed text-ink/85" x-show="r.content" x-text="r.content"></p>
            <p class="mt-4 text-sm font-semibold"><span x-text="r.name"></span> <span x-show="r.verified" class="ml-1 rounded-full bg-primary/10 px-2 py-0.5 align-middle text-[11px] font-medium text-primary">{{ fb.reviews_verified_label }}</span></p>
            <a :href="r.product.url" class="mt-3 flex items-center gap-3 rounded-xl bg-ink/[.03] p-2.5 text-sm transition hover:bg-ink/[.06]">
              <template x-if="r.product.cover"><img :src="r.product.cover.sm" alt="" width="40" height="40" class="h-10 w-10 shrink-0 rounded-md object-cover" loading="lazy"></template>
              <span class="min-w-0 truncate" x-text="r.product.name"></span>
            </a>
          </article>
        </template>
      </div>
      <div class="mt-8 text-center" x-show="more" x-cloak>
        <button type="button" class="btn btn-outline" @click="loadMore()" :disabled="loading">{{ fb.reviews_more_label }}</button>
      </div>
    </div>
    {% endif %}
  </div>
</section>
{% include "partials/feedback-modal.njk" %}
{% endblock %}
