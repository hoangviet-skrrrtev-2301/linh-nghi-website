{% extends "layout.njk" %}
{% from "partials/icons.njk" import icon %}
{% block title %}Chi tiết yêu cầu{% endblock %}
{% block heading %}Chi tiết yêu cầu{% endblock %}
{% block content %}
<div x-data="inquiryDetail({{ params.id | dump }})">
  <template x-if="d">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="space-y-6">
        <div class="card">
          <div class="card-head">
            <div>
              <p class="text-xs text-slate-500"><span x-text="d.type_label"></span><span x-show="d.channel === 'admin'"> · Shop tạo</span></p>
              <h2 class="font-mono text-lg font-semibold" x-text="d.code"></h2>
            </div>
            <span class="badge text-sm" :class="Admin.STATUS_COLOR[d.status]" x-text="d.status_label"></span>
          </div>
          <dl class="card-body grid gap-x-8 gap-y-4 sm:grid-cols-2">
            <div><dt class="text-xs text-slate-500">Khách hàng</dt><dd class="font-medium"><a :href="'{{ A }}/customers/' + d.customer_id" class="hover:text-brand-600" x-text="d.name"></a></dd></div>
            <div><dt class="text-xs text-slate-500">Điện thoại</dt><dd class="font-medium"><a :href="'tel:' + d.phone" class="text-brand-600" x-text="d.phone"></a>
              <a :href="'https://zalo.me/' + d.phone" target="_blank" class="ml-2 text-xs text-blue-600 hover:underline">Zalo</a></dd></div>
            <div x-show="d.email"><dt class="text-xs text-slate-500">Email</dt><dd><a :href="'mailto:' + d.email" class="text-brand-600" x-text="d.email"></a></dd></div>
            <div x-show="d.contact_via"><dt class="text-xs text-slate-500">Muốn liên hệ qua</dt><dd x-text="d.contact_via"></dd></div>
            <div x-show="d.address" class="sm:col-span-2"><dt class="text-xs text-slate-500">Địa chỉ</dt><dd x-text="d.address"></dd></div>
            <template x-for="r in detailRows"><div><dt class="text-xs text-slate-500" x-text="r[0]"></dt><dd class="font-medium" x-text="r[1]"></dd></div></template>
            <div x-show="d.message" class="sm:col-span-2"><dt class="text-xs text-slate-500">Lời nhắn / mô tả</dt><dd class="whitespace-pre-line rounded-lg bg-slate-50 p-3" x-text="d.message"></dd></div>
            <div x-show="d.origin_code" class="sm:col-span-2"><dt class="text-xs text-slate-500">Nguồn gốc</dt>
              <dd>Lên đơn từ <b x-text="d.origin_label.toLowerCase()"></b>, mã cũ <span class="font-mono text-xs" x-text="d.origin_code"></span> (khách tra cứu được bằng cả hai mã)</dd></div>
            <div x-show="d.parent" class="sm:col-span-2"><dt class="text-xs text-slate-500">Lên đơn từ yêu cầu</dt>
              <dd><a :href="'{{ A }}/inquiries/' + d.parent?.id" class="font-mono text-brand-600 hover:underline" x-text="d.parent?.code"></a></dd></div>
            <div x-show="d.children.length" class="sm:col-span-2"><dt class="text-xs text-slate-500">Đơn đã lên từ yêu cầu này</dt>
              <dd class="flex flex-wrap gap-2"><template x-for="c in d.children" :key="c.id">
                <a :href="'{{ A }}/inquiries/' + c.id" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-2.5 py-1 hover:bg-slate-50"><span class="font-mono text-xs" x-text="c.code"></span><span class="badge" :class="Admin.STATUS_COLOR[c.status]" x-text="c.status_label"></span></a>
              </template></dd></div>
          </dl>
        </div>

        {# ---- Sản phẩm & giá: shop chỉnh được sau khi liên hệ khách ---- #}
        <div class="card">
          <div class="card-head">
            <h3 class="card-title" x-text="d.type === 'order' ? 'Sản phẩm & giá' : 'Báo giá cho khách'"></h3>
            <span class="text-xs text-slate-500">Giá chỉnh được sau khi thỏa thuận với khách</span>
          </div>
          <div class="overflow-x-auto">
            <table class="table table-stack md:min-w-[700px]">
              <thead><tr><th class="stack-title md:min-w-[220px]">Sản phẩm</th><th class="w-24">Ni</th><th class="w-20">SL</th><th class="w-40">Đơn giá (₫)</th><th class="w-32 text-right">Thành tiền</th><th class="w-10"></th></tr></thead>
              <tbody>
                <template x-for="(it, i) in edit.items" :key="i">
                  <tr>
                    <td><input class="input" x-model="it.name" placeholder="Tên sản phẩm / mô tả" @input="dirty = true">
                      <p class="mt-1 text-xs text-slate-500" x-show="it.sku" x-text="'Mã: ' + it.sku"></p></td>
                    <td><input class="input" x-model="it.size" @input="dirty = true"></td>
                    <td><input type="number" min="1" class="input" x-model.number="it.qty" @input="dirty = true"></td>
                    <td><input type="number" min="0" step="1000" class="input" x-model="it.price" placeholder="Chưa có giá" @input="dirty = true"></td>
                    <td class="text-right font-medium" x-text="it.price === '' || it.price == null ? '—' : $fmt.vnd(it.price * it.qty)"></td>
                    <td><button type="button" class="btn btn-ghost btn-sm text-red-600" @click="edit.items.splice(i, 1); dirty = true" aria-label="Xóa dòng">{{ icon('trash', 'w-4 h-4') }}</button></td>
                  </tr>
                </template>
                <tr x-show="!edit.items.length"><td colspan="6" class="py-8 text-center text-slate-500">Chưa có sản phẩm. Thêm từ kho hoặc tự nhập dòng mới.</td></tr>
              </tbody>
            </table>
          </div>
          <div class="space-y-4 border-t border-slate-100 p-5">
            <div class="flex flex-wrap items-start gap-3">
              <div class="relative w-full max-w-sm">
                <input type="search" class="input" placeholder="Tìm sản phẩm trong kho để thêm..." x-model="pick.q" @input.debounce.300ms="searchProducts()" @focus="pick.open = true" @keydown.escape="pick.open = false">
                <div x-cloak x-show="pick.open && pick.results.length" @click.outside="pick.open = false" class="absolute z-20 mt-1 max-h-72 w-full overflow-y-auto rounded-xl border border-slate-200 bg-white p-1 shadow-lg">
                  <template x-for="p in pick.results" :key="p.id">
                    <button type="button" class="flex w-full items-center justify-between gap-3 rounded-lg px-3 py-2 text-left text-sm hover:bg-slate-50" @click="addProduct(p)">
                      <span class="truncate" x-text="p.name"></span><span class="shrink-0 text-xs text-slate-500" x-text="p.final_price != null ? $fmt.vnd(p.final_price) : 'Liên hệ'"></span>
                    </button>
                  </template>
                </div>
              </div>
              <button type="button" class="btn btn-secondary" @click="addLine()">{{ icon('plus', 'w-4 h-4') }} Thêm dòng tự nhập</button>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div><label class="label">Giảm giá / phụ phí (₫)</label>
                <input type="number" step="1000" class="input" x-model.number="edit.adjustment" @input="dirty = true" placeholder="VD: -500000 (giảm) hoặc 30000 (phí ship)">
                <p class="help">Số âm là giảm giá, số dương là phụ phí hoặc phí vận chuyển.</p></div>
              <div><label class="label">Lý do điều chỉnh</label><input class="input" x-model="edit.adjustment_note" @input="dirty = true" maxlength="300" placeholder="VD: Giảm cho khách quen, phí ship nội thành"></div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="text-sm text-slate-600">Tạm tính <b x-text="calc.sub != null ? $fmt.vnd(calc.sub) : '—'"></b>
                <span x-show="edit.adjustment"> · điều chỉnh <b x-text="$fmt.vnd(edit.adjustment)"></b></span></p>
              <p class="text-lg font-semibold text-brand-700">Tổng cộng: <span x-text="calc.total != null ? $fmt.vnd(calc.total) : 'Liên hệ (còn dòng chưa có giá)'"></span></p>
            </div>
            <div class="flex items-center gap-3">
              <button type="button" class="btn btn-primary" :disabled="saving || !dirty" @click="saveItems()">Lưu sản phẩm & giá</button>
              <span class="text-xs text-amber-600" x-show="dirty">Có thay đổi chưa lưu</span>
            </div>
          </div>
        </div>
      </div>

      <aside class="space-y-4">
        <div class="card card-body space-y-3">
          <label class="label">Cập nhật trạng thái</label>
          <div class="grid grid-cols-2 gap-2">
            <template x-for="s in d.flow" :key="s.key">
              <button class="btn btn-sm" :class="d.status === s.key ? 'btn-primary' : 'btn-secondary'" :disabled="saving" @click="changeStatus(s.key)" x-text="s.label"></button>
            </template>
          </div>
          <label class="flex items-start gap-2 text-sm" :class="!canNotify && 'opacity-60'">
            <input type="checkbox" class="mt-0.5 h-4 w-4 accent-brand-600" x-model="notify" :disabled="!canNotify">
            <span>Gửi email báo khách khi đổi trạng thái<span class="help block !mt-0" x-text="notifyHelp"></span></span>
          </label>
        </div>
        {# Thông tin vận chuyển: khách xem được ở trang tra cứu đơn #}
        <div class="card card-body space-y-3" x-show="d.type === 'order'">
          <label class="label !mb-0">Vận chuyển</label>
          <input class="input" list="carrier-list" placeholder="Đơn vị vận chuyển (GHN, GHTK, Viettel Post...)" x-model="ship.carrier" maxlength="80">
          <datalist id="carrier-list"><option>Giao hàng nhanh (GHN)</option><option>Giao hàng tiết kiệm (GHTK)</option><option>Viettel Post</option><option>J&amp;T Express</option><option>VNPost</option><option>Ahamove / Grab</option><option>Shop giao trực tiếp</option></datalist>
          <input class="input font-mono" placeholder="Mã vận đơn (nếu có)" x-model="ship.tracking_code" maxlength="100">
          <button class="btn btn-secondary btn-sm" :disabled="saving" @click="saveShip()">Lưu thông tin vận chuyển</button>
          <p class="help !mt-0">Khách thấy đơn vị vận chuyển và mã vận đơn khi tra cứu đơn bằng mã và số điện thoại.<span x-show="d.shipped_at"> Bắt đầu giao: <b x-text="$fmt.date(d.shipped_at)"></b>.</span></p>
        </div>
        <div class="card card-body space-y-2" x-show="d.type !== 'order'">
          <button class="btn btn-primary w-full" :disabled="saving" @click="convert()">{{ icon('bag', 'w-4 h-4') }} Lên đơn hàng từ yêu cầu này</button>
          <p class="help">Chuyển chính yêu cầu này thành đơn hàng (mã DH mới) để chốt giá và theo dõi giao hàng. Không tạo thêm bản ghi thứ hai; khách tra cứu được bằng mã cũ lẫn mã mới.</p>
        </div>
        <div class="card card-body">
          <label class="label">Ghi chú nội bộ</label>
          <textarea class="input" rows="4" x-model="d.admin_note" placeholder="Đã gọi lúc..., khách hẹn..."></textarea>
          <button class="btn btn-secondary btn-sm mt-2" :disabled="saving" @click="update({ admin_note: d.admin_note })">Lưu ghi chú</button>
        </div>
        <div class="card card-body space-y-2 text-sm text-slate-600">
          <p>Nhận lúc: <b x-text="$fmt.date(d.created_at)"></b></p>
          <p x-show="d.completed_at">Hoàn thành lúc: <b x-text="$fmt.date(d.completed_at)"></b></p>
          <template x-if="d.mail_status !== 'none'">
            <div class="space-y-2">
              <p>Email thông báo: <b x-text="{ sent: 'Đã gửi', failed: 'Gửi lỗi', not_configured: 'Chưa cấu hình email', pending: 'Đang gửi' }[d.mail_status]"></b></p>
              <button class="btn btn-secondary btn-sm" @click="resend()">{{ icon('mail', 'w-3.5 h-3.5') }} Gửi lại email thông báo</button>
            </div>
          </template>
          <p class="break-all text-xs text-slate-400" x-show="d.ip" x-text="'IP: ' + d.ip"></p>
        </div>
        {% if currentUser.role == 'owner' %}<button class="btn btn-ghost w-full text-red-600" @click="remove()">{{ icon('trash', 'w-4 h-4') }} Xóa yêu cầu</button>{% endif %}
      </aside>
    </div>
  </template>
</div>
{% endblock %}
